nextflow_pipeline {
    name "Test Kraken2 and Bracken on WGS reads, after the short-read QC and host removal"
    script "../main.nf"
    tag "pipeline"
    tag "test_kraken2"
    profile "test_kraken2"

    // the WGS test reads (2612: paired-end, two runs merged; 2612_se: single-end; 2613: paired-end) and the database of
    // the reference genomes of Methanobrevibacter smithii (taxid 2173) and Collinsella aerofaciens (taxid 74426)
    test("test_kraken2") {
        when {
            params {
                outdir = "${outputDir}"
            }
        }

        then {
            def stable_name       = getAllFilesFromDir( params.outdir, includeDir: true , ignore: [ 'pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**' ], relative: true )
            def software_versions = removeNextflowVersion( "${params.outdir}/pipeline_info/zellerlab_flexprofiler_software_mqc_versions.yml" )
            // the commit of the pipeline code changes with every commit
            software_versions.Workflow.remove( "zellerlab/flexprofiler_commit" )
            def read_counts       = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t" ) as List }
            def count             = { sample, column -> read_counts.find { row -> row[0] == sample }[read_counts[0].indexOf( column )] as int }
            def kraken2_table     = { name -> path( "${params.outdir}/kraken2/kraken2_test_kraken2_wgs.${name}.tsv" ).readLines().collect { line -> line.split( "\t" ) as List } }
            def kraken2_clade     = { taxid, sample ->
                def table = kraken2_table( "reads_clade" )
                table.find { row -> row[0] == taxid }[table[0].indexOf( sample )] as int
            }
            // the taxid of a species, by its name in the taxonomy table (taxid, name, rank, lineage)
            def kraken2_species   = { name ->
                def species = kraken2_table( "taxonomy" ).find { row -> row[1] == name && row[2] == "S" }
                assert species : "no species '${name}' in the Kraken2 taxonomy table"
                species[0]
            }
            def bracken_reads     = { taxid, sample ->
                def table = path( "${params.outdir}/bracken/bracken_test_kraken2_wgs.reads.tsv" ).readLines().collect { line -> line.split( "\t" ) as List }
                table.find { row -> row[0] == taxid }[table[0].indexOf( sample )] as int
            }
            // Kraken2 counts each mate: the reads given to it are the pairs left by the host removal, as two reads each,
            // or the single-end reads left
            def kraken2_input     = [ "2612": 2 * count( "2612", "hostremoval_retained_pairs" ), "2612_se": count( "2612_se", "hostremoval_retained_pairs" ), "2613": 2 * count( "2613", "hostremoval_retained_pairs" ) ]
            assertAll(
                { assert workflow.success },
                { assert snapshot ( workflow.trace.succeeded().size() ).match( "number_of_tasks" ) },
                { assert snapshot ( stable_name ).match( "filenames" ) },
                { assert snapshot ( software_versions ).match( "software_versions" ) },
                { assert snapshot ( read_counts ).match( "read_counts" ) },
                // the classified and unclassified reads add up to the reads given to Kraken2, and the classified ones are
                // those of the read counts
                { assert kraken2_input.every { sample, reads -> kraken2_clade( "0", sample ) + kraken2_clade( "1", sample ) == reads } },
                { assert kraken2_input.every { sample, _reads -> kraken2_clade( "1", sample ) == count( sample, "kraken2_test_kraken2_wgs_reads" ) } },
                // the reads of each species in every sample, which together are all the classified reads
                { assert [ "Methanobrevibacter smithii", "Collinsella aerofaciens" ].collectEntries { name -> [ ( name ): kraken2_input.keySet().collectEntries { sample -> [ ( sample ): kraken2_clade( kraken2_species( name ), sample ) ] } ] } == [
                    "Methanobrevibacter smithii": [ "2612": 97700, "2612_se": 15674, "2613": 17598 ],
                    "Collinsella aerofaciens":    [ "2612": 66296, "2612_se": 7390,  "2613": 16908 ],
                ] },
                // Bracken: the k-mers of each genome of the test database are all of its species, so no read assigned above
                // the species is redistributed, and the estimate of each species is its clade in Kraken2
                { assert [ "Methanobrevibacter smithii", "Collinsella aerofaciens" ].every { name -> kraken2_input.keySet().every { sample -> bracken_reads( kraken2_species( name ), sample ) == kraken2_clade( kraken2_species( name ), sample ) } } },
                { assert snapshot (
                    path( "${params.outdir}/bracken/bracken_test_kraken2_wgs.reads.tsv" ),
                    path( "${params.outdir}/bracken/bracken_test_kraken2_wgs.taxonomy.tsv" ),
                ).match( "bracken_tables" ) },
                { assert snapshot (
                    path( "${params.outdir}/kraken2/kraken2_test_kraken2_wgs.reads_clade.tsv" ),
                    path( "${params.outdir}/kraken2/kraken2_test_kraken2_wgs.reads_taxon.tsv" ),
                    path( "${params.outdir}/kraken2/kraken2_test_kraken2_wgs.taxonomy.tsv" ),
                ).match( "kraken2_tables" ) },
            )
        }
    }

    // a sample of which no read aligns or is classified: one read pair and one single-end read of random bases
    test("test_kraken2_no_hits") {
        when {
            params {
                outdir = "${outputDir}"
                input  = "${baseDir}/assets/test-data/samplesheet_no_hits.csv"
            }
        }

        then {
            def samples     = [ 'no_hits_pe', 'no_hits_se' ]
            def read_counts = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t", -1 ) as List }
            def count_of    = { sample, column -> read_counts.find { row -> row[0] == sample }[read_counts[0].indexOf( column )] }
            def kraken2_dir   = "${params.outdir}/kraken2/test_kraken2_wgs"
            def bracken_dir   = "${params.outdir}/bracken/test_kraken2_wgs"
            def kraken2_table = { name -> path( "${params.outdir}/kraken2/kraken2_test_kraken2_wgs.${name}.tsv" ).readLines() }
            def bracken_table = { name -> path( "${params.outdir}/bracken/bracken_test_kraken2_wgs.${name}.tsv" ).readLines() }
            assertAll(
                { assert workflow.success },
                // Kraken2: for each sample, a report with only the unclassified fragment (the pair is one fragment)
                { assert samples.every { sample -> path( "${kraken2_dir}/${sample}_test_kraken2_wgs.kraken2.report.txt" ).readLines() == [ "100.00\t1\t1\t0\t0\tU\t0\tunclassified" ] } },
                // the merged tables: all the reads unclassified (taxid 0), the pair counted twice
                { assert [ "reads_clade", "reads_taxon" ].every { name -> kraken2_table( name ) == [ "taxid\tno_hits_pe\tno_hits_se", "0\t2\t1" ] } },
                { assert kraken2_table( "taxonomy" ) == [ "taxid\tname\trank\tlineage", "0\tunclassified\tU\t0" ] },
                // Bracken: no reads at the species rank, so for each sample a table with only its header and an empty
                // report, and merged tables with the two samples and no taxon
                { assert samples.every { sample -> path( "${bracken_dir}/${sample}_test_kraken2_wgs.bracken.tsv" ).readLines() == [ "name\ttaxonomy_id\ttaxonomy_lvl\tkraken_assigned_reads\tadded_reads\tnew_est_reads\tfraction_total_reads" ] } },
                { assert samples.every { sample -> path( "${bracken_dir}/${sample}_test_kraken2_wgs.bracken.kraken2.report_bracken.txt" ).text == "" } },
                { assert bracken_table( "reads" ) == [ "taxid\tno_hits_pe\tno_hits_se" ] },
                { assert bracken_table( "taxonomy" ) == [ "taxid\tname\trank" ] },
                // the reads reach the profiler (each mate counted), which counts none of them
                { assert read_counts.collect { row -> row[0] } == [ 'sample' ] + samples },
                { assert samples.collect { sample -> [ count_of( sample, 'hostremoval_retained_pairs' ), count_of( sample, 'profiler_input_reads' ), count_of( sample, 'kraken2_test_kraken2_wgs_reads' ) ] } == [ [ '1', '2', '0' ], [ '1', '1', '0' ] ] },
                { assert snapshot ( read_counts ).match( "read_counts_no_hits" ) },
                { assert snapshot (
                    kraken2_table( "reads_clade" ),
                    kraken2_table( "reads_taxon" ),
                    kraken2_table( "taxonomy" ),
                ).match( "kraken2_tables_no_hits" ) },
                { assert snapshot (
                    bracken_table( "reads" ),
                    bracken_table( "taxonomy" ),
                ).match( "bracken_tables_no_hits" ) },
            )
        }
    }
}

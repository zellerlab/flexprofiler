nextflow_pipeline {
    name "Test motus4"
    script "../main.nf"
    tag "pipeline"
    tag "test_motus4"
    profile "test_motus4"

    test("test_motus4") {
        when {
            params {
                outdir = "${outputDir}"
            }
        }

        then {
            def stable_name       = getAllFilesFromDir( params.outdir, includeDir: true , ignore: [ 'pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**' ], relative: true )
            def software_versions = removeNextflowVersion( "${params.outdir}/pipeline_info/zellerlab_flexprofiler_software_mqc_versions.yml" )
            // the commit of the pipeline code changes with every commit
            software_versions.Workflow.remove( "zellerlab/flexprofiler_commit" )
            def read_counts       = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t" ) as List }
            def motus4_merge      = file( "${params.outdir}/motus4/merge/motus4_db_mOTU_combined_reports.txt" )
            // the samples of a merged table, from its header (the line starting with the name of its first column), without
            // the taxonomy column and the _db_mOTU suffix of the motus reports
            def samples_in        = { lines, first_column -> lines.find { line -> line.startsWith( "${first_column}\t" ) }.split( "\t" ).drop( 1 ).findAll { column -> !( column in [ "consensus_taxonomy", "Taxonomy" ] ) }.collect { column -> column - ~/_db_mOTU$/ } }
            // the value of a cell of a merged table, by feature (first column) and sample (column of the header, the line
            // starting with the name of the first column)
            def cell_of           = { lines, first_column, feature, sample ->
                def header = lines.find { line -> line.startsWith( "${first_column}\t" ) }.split( "\t" ).collect { column -> column - ~/_db_mOTU$/ }
                lines.find { line -> line.startsWith( "${feature}\t" ) }.split( "\t" )[ header.indexOf( sample ) ]
            }
            def samples           = [ '2612', '2612_se', '2613' ]
            assertAll(
                { assert workflow.success },
                { assert snapshot ( software_versions ).match( "software_versions" ) },
                { assert snapshot ( workflow.trace.succeeded().size() ).match( "number_of_tasks" ) },
                { assert snapshot ( stable_name ).match( "filenames" ) },
                { assert snapshot ( read_counts ).match( "read_counts" ) },
                // the whole merged report (the four mOTUs of the test database and the unassigned)
                { assert snapshot ( motus4_merge.readLines() ).match( "counts" ) },
                { assert samples_in( motus4_merge.readLines(), 'mOTU' ).sort() == samples },
                // a few counts: [ mOTU, sample, value ]
                { assert [
                    [ 'mOTUv4.0_014686', '2612', '15' ], [ 'mOTUv4.0_014686', '2613', '7' ], [ 'mOTUv4.0_000924', '2612_se', '3' ],
                    [ 'mOTUv4.0_000924', '2612', '18' ], [ 'mOTUv4.0_unassigned', '2612', '116' ], [ 'mOTUv4.0_unassigned', '2612_se', '32' ], [ 'mOTUv4.0_unassigned', '2613', '75' ],
                ].every { motu, sample, value -> cell_of( motus4_merge.readLines(), 'mOTU', motu, sample ) == value } },
                { assert snapshot (
                    getAllFilesFromDir( "${params.outdir}/motus4", include: [ '**.out' ] ).collect { file -> "${file.getName()} contains 's__Collinsella sp900768795' " + file.text.contains( "s__Collinsella sp900768795" ) },
                    getAllFilesFromDir( "${params.outdir}/motus4", include: [ '**.log' ] ).collect { file -> "${file.getName()} contains 'Finished mOTUs': " + file.text.contains( "Finished mOTUs" ) },
                    "${motus4_merge.getName()} contains 'unassigned': " + motus4_merge.text.contains( "mOTUv4.0_unassigned\td__;p___A;c__;o__;f__;g__;s__" ),
                    "${motus4_merge.getName()} contains 'Methanobrevibacter_A smithii': " + motus4_merge.text.contains( "s__Methanobrevibacter_A smithii" ),
                ).match("motus4") },
            )
        }
    }

    // a sample of which no read aligns or is classified: one read pair and one single-end read of random bases
    test("test_motus4_no_hits") {
        when {
            params {
                outdir = "${outputDir}"
                input  = "${baseDir}/assets/test-data/samplesheet_no_hits.csv"
            }
        }

        then {
            def samples     = [ 'no_hits_pe', 'no_hits_se' ]
            def read_counts = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t", -1 ) as List }
            def count_of    = { sample, column -> read_counts.find { row -> row[0] == sample }[read_counts[0].indexOf( column )] }
            def motus4_dir    = "${params.outdir}/motus4/profile/db_mOTU"
            def motus4_merge  = path( "${params.outdir}/motus4/merge/motus4_db_mOTU_combined_reports.txt" ).readLines()
            def motus4_header = "#tool_version=4.0.4\tdatabase_version=4.0\tmin_alignment_length=75\tmin_mgcs=3\tcount_mode=INSERT_SCALED\tvalue_type=counts"
            assertAll(
                { assert workflow.success },
                // a profile for each sample, with only its two header lines, as mOTUs v4 writes only the mOTUs with reads
                { assert getAllFilesFromDir( motus4_dir, include: [ '*.out' ] ).collect { file -> file.getName() }.sort() == samples.collect { sample -> "${sample}_db_mOTU.out".toString() } },
                { assert samples.every { sample -> path( "${motus4_dir}/${sample}_db_mOTU.out" ).readLines() == [ motus4_header, "mOTU\tTaxonomy\t${sample}_db_mOTU".toString() ] } },
                // the empty table of marker gene cluster counts written by motus4_patch.py, and its log
                { assert samples.every { sample -> path( "${motus4_dir}/${sample}_db_mOTU.out.mgc" ).readLines() == [ "#tool_version=4.0.4\tdatabase_version=4.0\tmin_alignment_length=75", "MGC\tINSERT_RAW\tINSERT_NORM\tINSERT_SCALED\tBASE_RAW\tBASE_NORM" ] } },
                { assert samples.every { sample -> path( "${motus4_dir}/${sample}_db_mOTU.log" ).text.contains( "No read aligned to the marker genes: writing an empty profile" ) } },
                { assert samples.every { sample -> path( "${motus4_dir}/${sample}_db_mOTU.log" ).text.contains( "Read 0 aligned inserts of which 0.0% are multimappers" ) } },
                // the merged table: the header lines, with the two samples, and no mOTU
                { assert motus4_merge == [ motus4_header, "mOTU\tTaxonomy\tno_hits_pe_db_mOTU\tno_hits_se_db_mOTU" ] },
                // the reads reach the profiler (each mate counted), which counts none of them
                { assert read_counts.collect { row -> row[0] } == [ 'sample' ] + samples },
                { assert samples.collect { sample -> [ count_of( sample, 'hostremoval_retained_pairs' ), count_of( sample, 'profiler_input_reads' ), count_of( sample, 'motus4_db_mOTU_pairs' ) ] } == [ [ '1', '2', '0' ], [ '1', '1', '0' ] ] },
                { assert snapshot ( read_counts ).match( "read_counts_no_hits" ) },
                { assert snapshot ( motus4_merge ).match( "counts_no_hits" ) },
            )
        }
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options (the published files are chosen in the subworkflows, see the
    output block in main.nf)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: UNTAR {
        ext.prefix = { "${archive.simpleName}" }
    }

    // QC of the reads (READS_QC) at each stage (meta.qc_stage): raw, and processed (the reads given to the profilers,
    // merged per sample and library strategy with --perform_runmerging, as named by run_accession); the singletons are
    // the paired-end reads left without their mate by PathSeq-T2T. The stage ends the prefix, right before the suffixes
    // added by the tools (_1/_2 for paired-end reads, then _fastqc...), so that MultiQC can split the reports by stage
    // (path_filters in assets/multiqc_config.yml) whatever the sample and run names contain
    withName: '.*:READS_QC:FASTQC' {
        cpus   = 2
        memory = { 15.GB * task.attempt }
        time   = { 1.h * task.attempt }
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_${meta.run_accession}${meta.singletons ? '_singletons' : ''}_${meta.qc_stage}" }
    }

    // Falco runs one file at a time on one thread, with little memory
    withName: '.*:READS_QC:FALCO' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
        ext.prefix = { "${meta.id}_${meta.run_accession}${meta.singletons ? '_singletons' : ''}_${meta.qc_stage}" }
    }

    withName: FASTP_SINGLE {
        cpus   = 6
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
        ext.args   = [
            params.shortread_qc_skipadaptertrim ? "--disable_adapter_trimming" : "",
            // with PathSeq-T2T, only the trimming: PathSeqFilterSpark filters the reads by quality
            params.pathseq_t2t ? "--disable_quality_filtering" : "",
            params.shortread_qc_adapterlist ? "" : params.shortread_qc_adapter1 ? "--adapter_sequence ${params.shortread_qc_adapter1}" : "",
            "--length_required ${params.shortread_qc_minlength}",
            params.shortread_qc_dedup ? "--dedup" : "",
        ].join(' ').trim()
        ext.prefix = { "${meta.id}_${meta.run_accession}" }
    }

    withName: FASTP_PAIRED {
        cpus   = 6
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
        ext.args   = [
            params.shortread_qc_includeunmerged ? '--include_unmerged' : '',
            params.shortread_qc_skipadaptertrim ? "--disable_adapter_trimming" : "",
            // with PathSeq-T2T, only the trimming: PathSeqFilterSpark filters the reads by quality
            params.pathseq_t2t ? "--disable_quality_filtering" : "",
            params.shortread_qc_adapterlist ? "" : params.shortread_qc_adapter1 ? "--adapter_sequence ${params.shortread_qc_adapter1}" : "",
            params.shortread_qc_adapterlist ? "" : params.shortread_qc_adapter2 ? "--adapter_sequence_r2 ${params.shortread_qc_adapter2}" : "--detect_adapter_for_pe",
            "--length_required ${params.shortread_qc_minlength}",
            params.shortread_qc_dedup ? "--dedup" : "",
        ].join(' ').trim()
        ext.prefix = { "${meta.id}_${meta.run_accession}" }
    }

    withName: BOWTIE2_ALIGN {
        cpus   = 11
        memory = { 20.GB * task.attempt }
        time   = { 5.h * task.attempt }
        // following best practice https://doi.org/10.1016/j.crmeth.2025.101218, also in aligning the mates of the
        // paired-end reads separately (see subworkflows/local/shortread_hostremoval.nf)
        // --reorder keeps the unmapped reads in the input order with multiple threads,
        // since the results of mOTUs depend on the order of the reads
        ext.args = "--very-sensitive-local --reorder"
        ext.prefix = { meta.mate ? "${meta.id}_${meta.run_accession}_${meta.mate}" : "${meta.id}_${meta.run_accession}" }
    }

    // per run, so that the outputs of the runs of a sample do not overwrite each other in bbmap/
    withName: BBMAP_REPAIR {
        ext.prefix = { "${meta.id}_${meta.run_accession}" }
    }

    withName: BBMAP_REPAIR_HOSTREMOVAL {
        // repair.sh keeps the reads without their mate (the mates of the reads aligned to the host) in memory
        memory = { 8.GB * task.attempt }
        ext.prefix = { "${meta.id}_${meta.run_accession}.unmapped" }
    }

    withName: SAMTOOLS_STATS {
        ext.prefix = { "${meta.id}_${meta.run_accession}" }
    }

    withName: MERGE_RUNS {
        ext.prefix = { "${meta.id}_${meta.run_accession}" }
    }

    //
    // PathSeq-T2T host filtering (--pathseq_t2t, subworkflows/local/pathseq_t2t.nf). The files are named by the sample,
    // and by the run without run merging, as those of the profilers
    //

    withName: 'BWA_INDEX_GRCH38|BWA_INDEX_T2T' {
        // bwa index needs about 5.4 bytes per base, 17GB for a human genome; the memory of the module is from the size
        // of the FASTA, which is too little if it is compressed
        memory = { 24.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withName: BWA_GRCH38 {
        // the parameters of the NCI Genomic Data Commons, as in the benchmark of the paper. The read group is needed:
        // PathSeqFilterSpark drops the reads without one
        ext.args   = { "-T 0 -R '@RG\\tID:${params.perform_runmerging ? meta.id : "${meta.id}_${meta.run_accession}"}\\tSM:${meta.id}\\tPL:${meta.instrument_platform}'" }
        ext.prefix = { params.perform_runmerging ? "${meta.id}.grch38" : "${meta.id}_${meta.run_accession}.grch38" }
    }

    withName: STAR_GENOMEGENERATE_GRCH38 {
        // STAR needs about 32GB to index a human genome (--limitGenomeGenerateRAM is 90% of the memory of the task)
        cpus   = 8
        memory = { 48.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withName: STAR_GRCH38 {
        // --pathseq_t2t_grch38_aligner star: an unsorted BAM (the default of the module: the mates together) with all
        // the reads, the unaligned ones too, and one alignment per read, so that each read is once in the BAM, as with
        // bwa mem; the reads per gene of the index (GeneCounts); the read group, as for bwa (PathSeqFilterSpark drops
        // the reads without one); two passes, as the STAR route of pathseq-t2t-nextflow, the junctions found in the
        // first being added to the index for the second (about twice the time of one pass)
        cpus   = 12
        memory = { 40.GB * task.attempt }
        time   = { 24.h * task.attempt }
        ext.args   = { [
            "--outSAMunmapped Within KeepPairs",
            "--outSAMmultNmax 1",
            "--quantMode GeneCounts",
            "--twopassMode Basic",
            "--outSAMattrRGline ID:${params.perform_runmerging ? meta.id : "${meta.id}_${meta.run_accession}"} SM:${meta.id} PL:${meta.instrument_platform}",
        ].join(' ') }
        ext.prefix = { params.perform_runmerging ? "${meta.id}.grch38" : "${meta.id}_${meta.run_accession}.grch38" }
    }

    withName: PATHSEQT2T_PREFILTER {
        cpus   = 4
        memory = { 4.GB * task.attempt }
        time   = { 8.h * task.attempt }
        ext.prefix = { params.perform_runmerging ? "${meta.id}" : "${meta.id}_${meta.run_accession}" }
    }

    withName: PATHSEQT2T_QCFILTER {
        // as upstream; three quarters of the memory are given to Java, the rest is for the BWA index image of the host
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
        ext.args   = { "--min-clipped-read-length ${params.pathseq_min_clipped_read_length}" }
        ext.prefix = { params.perform_runmerging ? "${meta.id}" : "${meta.id}_${meta.run_accession}" }
    }

    withName: PATHSEQT2T_T2TFILTER {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
        // the parameters of the NCI Genomic Data Commons, as upstream
        ext.args   = "-T 0"
        ext.prefix = { params.perform_runmerging ? "${meta.id}" : "${meta.id}_${meta.run_accession}" }
    }

    withName: MOTUS4_PROFILE {
        cpus   = 2
        memory = { 30.GB * task.attempt }
        time   = { 6.h * task.attempt }
        tag        = { "${meta.db_name}|${meta.id}" }
        ext.prefix = { params.perform_runmerging ? "${meta.id}_${meta.db_name}" : "${meta.id}_${meta.run_accession}_${meta.db_name}" }
    }

    withName: MOTUS4_RENAME_READS {
        // the extension (fastq.gz) is added by the module
        ext.prefix = { "${params.perform_runmerging ? meta.id : "${meta.id}_${meta.run_accession}"}_read${meta.paired_idx}_renamed_reads" }
        ext.args = "-c fastx"
        ext.args2 = "'{sub(/\\/1\$|\\/2\$/, \"\", \$name); print \"@\"\$name\"\\n\"\$seq\"\\n+\\n\"\$qual}'"
    }

    withName: MOTUS4_MERGE {
        cpus   = 1
        memory = { 100.MB * task.attempt }
        time   = { 10.min * task.attempt }
        ext.prefix = { "motus4_${meta.id}_combined_reports" }
        memory = { 10.GB * task.attempt }
    }

    withName: MOTUS3_PROFILE {
        cpus   = 2
        memory = { 30.GB * task.attempt }
        time   = { 6.h * task.attempt }
        tag        = { "${meta.db_name}|${meta.id}" }
        ext.prefix = { params.perform_runmerging ? "${meta.id}_${meta.db_name}" : "${meta.id}_${meta.run_accession}_${meta.db_name}" }
        // -c produces counts instead of rel. ab.
        // -q prints the full taxonomy string
        ext.args = "-c -q"
    }

    withName: MOTUS3_MERGE {
        cpus   = 1
        memory = { 100.MB * task.attempt }
        time   = { 10.min * task.attempt }
        ext.prefix = { "motus3_${meta.id}_combined_reports" }
        memory = { 10.GB * task.attempt }
    }

    withName: BWA_ALIGN {
        // shared by cayman and gqlib, meta.db_name is the name shared by the databases with the same fasta
        tag        = { "${meta.db_name}|${meta.id}" }
        // same bwa mem arguments used internally by cayman and gqlib
        ext.args   = { "-R '@RG\\tID:${meta.single_end ? 1 : 2}\\tSM:${meta.id}' -K 10000000 -v 1 -a" }
        ext.prefix = { params.perform_runmerging ? "${meta.id}_${meta.db_name}" : "${meta.id}_${meta.run_accession}_${meta.db_name}" }
    }

    withName: CAYMAN_PROFILE {
        // the profiling is single-threaded, the alignment is done in BWA_ALIGN
        cpus       = 1
        tag        = { "${meta.db_name}|${meta.annot_db_name}|${meta.id}" }
        // the settings of cayman (cayman/functions.py in cayman 0.13.0), given explicitly
        // even when they are the defaults of gqlib, in case these change
        ext.args   = "--ambig_mode 1overN --min_identity 0.97 --min_seqlen 45 --restrict_metrics raw,rpkm"
        ext.prefix = { params.perform_runmerging ? "${meta.id}_${meta.db_name}_${meta.annot_db_name}" : "${meta.id}_${meta.run_accession}_${meta.db_name}_${meta.annot_db_name}" }
    }
    
    withName: GQLIB_PROFILE_GENES {
        // the profiling is single-threaded, the alignment is done in BWA_ALIGN
        cpus       = 1
        tag        = { "${meta.db_name}|${meta.annot_db_name}|${meta.id}" }
        // the settings of the gffquant profiler of nevermore, with the alignment filters
        // (defaults of gffquant and gqlib) given explicitly, in case these change
        ext.args   = "--ambig_mode 1overN --min_identity 0.97 --min_seqlen 45 --restrict_metrics raw,lnorm,scaled,rpkm"
        ext.prefix = { params.perform_runmerging ? "${meta.id}_${meta.db_name}_${meta.annot_db_name}" : "${meta.id}_${meta.run_accession}_${meta.db_name}_${meta.annot_db_name}" }
    }

    withName: CAYMAN_MERGE {
        memory = { 10.GB * task.attempt }
    }

    withName: GQLIB_MERGE {
        memory = { 10.GB * task.attempt }
    }

    // PacBio HiFi reads: the reads with more than 10 expected errors (about 0.7% of a full-length 16S, ~Q22) or with Ns
    // are removed, then those with a low-quality base by BBDUK_PACBIO, as in the best practice for full-length 16S
    // (Callahan et al. 2019), but with maxEE relaxed from 2: that is meant for DADA2 denoising, and removes about half of
    // the Kinnex 16S reads, while IDTAXA classifies single reads and tolerates a few errors (mostly homopolymer lengths,
    // in the binned HiFi qualities). HiFi base qualities go up to Q93 (vsearch accepts up to Q41 by default)
    withName: VSEARCH_FASTQFILTER {
        ext.args   = '--fastq_maxee 10 --fastq_maxns 0 --fastq_qmax 93'
        ext.prefix = { "${meta.id}_${meta.run_accession}" }
    }

    // PacBio HiFi reads, after VSEARCH_FASTQFILTER: the reads with a base of quality below 3 are removed (minQ of DADA2
    // in Callahan et al. 2019). The quality offset is set (qin=33), as BBDuk takes the HiFi qualities (up to Q93) for
    // the offset 64 otherwise, and the qualities are kept up to Q93 (maxcalledquality), instead of being capped at Q50
    withName: BBDUK_PACBIO {
        ext.args   = 'qin=33 maxcalledquality=93 mbq=3'
        ext.prefix = { "${meta.id}_${meta.run_accession}_bbduk" }
    }

    // the long amplicon reads oriented as the reference sequences (--amplicon_orient_reference), before PIMENTO
    withName: VSEARCH_ORIENT {
        ext.prefix = { "${meta.id}_${meta.run_accession}" }
    }

    // paired-end mates are searched separately, as unmerged reads: all the primers of the library, forward and reverse,
    // are searched at the start of the reads, so each mate gets the primer it starts with. Single-end reads (also the
    // long reads, oriented) are searched in --merged mode, for the forward primers at the start and the reverse ones at
    // the end
    withName: PIMENTO_STD {
        ext.args   = { meta.single_end ? '--merged' : '' }
        ext.prefix = { "${meta.id}_${meta.run_accession}_${meta.mate}" }
    }

    // the primers found by PIMENTO for the run (meta.primers), searched at the start of both mates, so that the pairs
    // in the other orientation are trimmed too
    withName: CUTADAPT_PRIMERS {
        ext.args = { (meta.primers.collect { primer -> "-g ${primer}" } + (meta.single_end ? [] : meta.primers.collect { primer -> "-G ${primer}" })).join(' ') }
        ext.prefix = { "${meta.id}_${meta.run_accession}_primers" }
    }

    // the reverse complement of the primers, at the end of the reads running past the end of the amplicon
    withName: CUTADAPT_READTHROUGH {
        ext.args = { (meta.primers_revcomp.collect { primer -> "-a ${primer}" } + (meta.single_end ? [] : meta.primers_revcomp.collect { primer -> "-A ${primer}" })).join(' ') }
        ext.prefix = { "${meta.id}_${meta.run_accession}_readthrough" }
    }

    // the long reads: the pair of primers of the run (meta.primer_linked), both required, the reads without them
    // discarded, in either orientation (--revcomp: the reads are written in the orientation of the forward primer), and
    // the length window of the full-length 16S (to change for shorter amplicons, keeping -g '${meta.primer_linked}')
    withName: CUTADAPT_LINKED {
        ext.args = { "-g '${meta.primer_linked}' --revcomp --discard-untrimmed -m 1000 -M 1600" }
        ext.prefix = { "${meta.id}_${meta.run_accession}_linked" }
    }

    withName: VSEARCH_MERGEJOIN {
        // after the primer and read-through trimming, the reverse read can extend past the start of the forward read
        ext.args = '--fastq_allowmergestagger'
        ext.prefix = { "${meta.id}_${meta.run_accession}" }
    }

    withName: FASTP_AMPLICON_MERGE {
        // only merging, the reads were already processed (fastp keeps the unmerged mates of the pairs, as they are)
        ext.args = [
            '--include_unmerged',
            '--disable_adapter_trimming',
            '--disable_quality_filtering',
            '--disable_length_filtering',
            '--disable_trim_poly_g',
        ].join(' ')
        ext.prefix = { "${meta.id}_${meta.run_accession}_amplicon_merge" }
    }

    withName: KRAKEN2_KRAKEN2 {
        // the database is loaded in memory (PlusPF: ~80GB)
        cpus   = 8
        memory = { 128.GB * task.attempt }
        time   = { 12.h * task.attempt }
        tag        = { "${meta.db_name}|${meta.id}" }
        // if no options are given for the database: the minimizer data, and with --pathseq_t2t the confidence threshold of
        // PathSeq-T2T (Dohlman et al., Cell 2026)
        ext.args   = { meta.db_params ?: (params.pathseq_t2t ? "--confidence 0.15 --report-minimizer-data" : "--report-minimizer-data") }
        ext.prefix = { "${params.perform_runmerging ? meta.id : "${meta.id}_${meta.run_accession}"}_${meta.db_name}${meta.singletons ? '_singletons' : ''}" }
    }

    withName: STAR_GENECOUNTSMERGE {
        memory = { 4.GB * task.attempt }
        ext.prefix = { "${meta.id}_gene_counts" }
    }

    withName: KRAKEN2_MERGE {
        memory = { 4.GB * task.attempt }
    }

    withName: IDTAXA_CLASSIFY {
        cpus   = 16
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
        tag        = { "${meta.db_name}|${meta.id}" }
        ext.threshold = { params.idtaxa_threshold }
        // the long reads are oriented as the gene by the primer trimming (vsearch --orient, or cutadapt --revcomp with the
        // primers given), so only their top strand is classified; the short reads can be in both orientations (libraries
        // ligated in both orientations), so both strands are
        ext.strand = { meta.type == 'long' && params.perform_amplicon_primertrimming ? 'top' : 'both' }
        ext.prefix = { params.perform_runmerging ? "${meta.id}_${meta.db_name}" : "${meta.id}_${meta.run_accession}_${meta.db_name}" }
    }

    withName: IDTAXA_MERGE {
        ext.ranks  = { params.idtaxa_ranks }
    }

    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        memory = { 10.GB * task.attempt }
        scratch = { "${workDir}/multiqc_scratch" }
    }
}

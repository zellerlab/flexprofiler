/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing the PathSeq-T2T host filtering with STAR (--pathseq_t2t_grch38_aligner star)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    As test_pathseq_t2t, on simulated RNA-seq reads, with a GTF of two genes on the test GRCh38, made by
    assets/test-data/scripts/make_pathseq_t2t_rna_data.py (see assets/test-data/README.md).

    Use as follows:
        nextflow run zellerlab/flexprofiler -profile test_pathseq_t2t_star,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_pathseq_t2t.config'

params {
    config_profile_name          = 'PathSeq-T2T STAR test profile'
    config_profile_description   = 'Minimal test to check the PathSeq-T2T host filtering with STAR, on RNA-seq reads'
    input                        = "${projectDir}/assets/test-data/samplesheet_pathseq_t2t_rna.csv"
    pathseq_t2t_grch38_aligner   = 'star'
    pathseq_t2t_grch38_gtf       = "${projectDir}/assets/test-data/data/pathseq_t2t/grch38_test.gtf"
}

process {
    // the test references are tiny
    withName: 'STAR_GENOMEGENERATE_GRCH38|STAR_GRCH38|GUNZIP_GRCH38_FASTA' {
        cpus   = 2
        memory = 2.GB
    }
}

nextflow_pipeline {
    name "Test cayman"
    script "../main.nf"
    tag "pipeline"
    tag "test_cayman"
    profile "test_cayman"

    test("test_cayman") {
        when {
            params {
                outdir = "${outputDir}"
            }
        }

        then {
            def stable_name       = getAllFilesFromDir( params.outdir, includeDir: true , ignore: [ 'pipeline_info/*.{html,json,txt}' ], relative: true )
            def software_versions = removeNextflowVersion( "${params.outdir}/pipeline_info/zellerlab_flexprofiler_software_mqc_versions.yml" )
            def read_counts       = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t" ) as List }
            def cayman_profiles   = getAllFilesFromDir( "${params.outdir}/cayman", include: [ '**.cazy.txt.gz' ] )
            def cayman_merge      = path( "${params.outdir}/cayman/merge/GMGC10.human-gut.95nr.0.5.percent.prevalence/cayman_v3/GMGC10.human-gut.95nr.0.5.percent.prevalence_cayman_v3.cazy.uniq_raw.txt.gz" )
            def cayman_merge_rows = cayman_merge.linesGzip
            def cayman_merge_rpkm = path( "${params.outdir}/cayman/merge/GMGC10.human-gut.95nr.0.5.percent.prevalence/cayman_v3/GMGC10.human-gut.95nr.0.5.percent.prevalence_cayman_v3.cazy.uniq_rpkm.txt.gz" )
            // the rows of a merged table for some features (first column), with the counts of each sample
            def rows_of           = { lines, features -> lines.findAll { line -> line.split( "\t" )[0] in features } }
            assertAll(
                { assert workflow.success },
                { assert snapshot ( software_versions ).match( "software_versions" ) },
                { assert snapshot ( workflow.trace.succeeded().size() ).match( "number_of_tasks" ) },
                { assert snapshot ( stable_name ).match( "filenames" ) },
                { assert snapshot ( read_counts ).match( "read_counts" ) },
                // the raw counts and the rpkm
                { assert snapshot (
                    rows_of( cayman_merge_rows, [ 'feature', 'total_reads', 'filtered_reads', 'GH13', 'CBM48' ] ),
                    rows_of( cayman_merge_rpkm.linesGzip, [ 'feature', 'total_reads', 'filtered_reads', 'GH13', 'CBM48' ] ),
                ).match( "counts" ) },
                { assert snapshot (
                    cayman_profiles.collect { file -> "${file.getName()} contains 'total_reads': " + path( file.toString() ).linesGzip.any { it.startsWith( "total_reads\t" ) } },
                    cayman_profiles.collect { file -> "${file.getName()} contains 'GH13': " + path( file.toString() ).linesGzip.any { it.startsWith( "GH13\t" ) } },
                    getAllFilesFromDir( "${params.outdir}/cayman", include: [ '**.log' ] ).collect { file -> "${file.getName()} contains 'Finished.': " + file.text.contains( "Finished." ) },
                    "${cayman_merge.getFileName()} contains 'total_reads': " + cayman_merge_rows.any { it.startsWith( "total_reads\t" ) },
                    "${cayman_merge.getFileName()} contains 'GH13': " + cayman_merge_rows.any { it.startsWith( "GH13\t" ) },
                    "${cayman_merge.getFileName()} contains '2612': " + cayman_merge_rows[0].split( "\t" ).contains( "2612" ),
                    "${cayman_merge.getFileName()} contains '2613': " + cayman_merge_rows[0].split( "\t" ).contains( "2613" ),
                ).match("cayman") },
            )
        }
    }
}

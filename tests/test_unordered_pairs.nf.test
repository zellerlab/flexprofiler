nextflow_pipeline {
    name "Test PE reads in a different order in the two files"
    script "../main.nf"
    tag "pipeline"
    tag "test_unordered_pairs"
    profile "test_all"

    test("test_unordered_pairs") {
        when {
            params {
                // the reads of sample 2613, with the reads of the second file sorted by sequence
                input                   = "${baseDir}/assets/test-data/samplesheet_unordered_pairs.csv"
                outdir                  = "${outputDir}"
                // the pairs are put back in order with bbmap repair
                perform_repair_pe_order = true
                // to check the order of the pairs given to the profilers
                save_analysis_ready_fastqs = true
            }
        }

        then {
            def stable_name       = getAllFilesFromDir( params.outdir, includeDir: true , ignore: [ 'pipeline_info/*.{html,json,txt}' ], relative: true )
            def software_versions = removeNextflowVersion( "${params.outdir}/pipeline_info/zellerlab_flexprofiler_software_mqc_versions.yml" )
            def read_counts       = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t" ) as List }
            def gene_catalogue    = "GMGC10.human-gut.95nr.0.5.percent.prevalence"
            // the samples of a merged table, from its header (the line starting with the name of its first column), without
            // the taxonomy column and the _db_mOTU suffix of the motus reports
            def samples_in        = { lines, first_column -> lines.find { line -> line.startsWith( "${first_column}\t" ) }.split( "\t" ).drop( 1 ).findAll { column -> !( column in [ "consensus_taxonomy", "Taxonomy" ] ) }.collect { column -> column - ~/_db_mOTU$/ } }
            // the value of a cell of a merged table, by feature (first column) and sample (column of the header, the line
            // starting with the name of the first column)
            def cell_of           = { lines, first_column, feature, sample ->
                def header = lines.find { line -> line.startsWith( "${first_column}\t" ) }.split( "\t" ).collect { column -> column - ~/_db_mOTU$/ }
                lines.find { line -> line.startsWith( "${feature}\t" ) }.split( "\t" )[ header.indexOf( sample ) ]
            }
            def samples           = [ '2613_unordered' ]
            def count_of          = { column -> read_counts.find { row -> row[0] == "2613_unordered" }[read_counts[0].indexOf( column )] }
            // the number of pairs of two fastqs, and of those whose mates have different names (without the comment and
            // the /1 and /2 suffix), read line by line as the files are large
            def unsynced_pairs    = { file_1, file_2 ->
                def name    = { line -> line.split( /\s/ )[0].replaceAll( /\/[12]$/, '' ) }
                def readers = [ file_1, file_2 ].collect { file -> new java.util.zip.GZIPInputStream( new FileInputStream( file.toString() ) ).newReader() }
                def counts  = [ 0, 0 ]
                def i       = 0
                def line_1
                while ( ( line_1 = readers[0].readLine() ) != null ) {
                    def line_2 = readers[1].readLine()
                    if ( i % 4 == 0 ) {
                        counts[0]++
                        if ( name( line_1 ) != name( line_2 ) ) counts[1]++
                    }
                    i++
                }
                readers*.close()
                counts
            }
            def input_dir         = "${baseDir}/assets/test-data/data/fastq"
            def output_prefix     = "${params.outdir}/analysis_ready_fastqs/2613_unordered_ERR5766181.unmapped"
            // the merged table of each tool, with the name of its first column
            def merged            = [
                motus4: [ file( "${params.outdir}/motus4/merge/motus4_db_mOTU_combined_reports.txt" ).readLines(), 'mOTU' ],
                motus3: [ file( "${params.outdir}/motus3/merge/motus3_db_mOTU_combined_reports.txt" ).readLines(), '#mOTU' ],
                cayman: [ path( "${params.outdir}/cayman/merge/${gene_catalogue}/cayman_v3/${gene_catalogue}_cayman_v3.cazy.uniq_raw.txt.gz" ).linesGzip, 'feature' ],
                gqlib:  [ path( "${params.outdir}/gqlib/merge/${gene_catalogue}/emapper_v2.1.7/${gene_catalogue}_emapper_v2.1.7.gene_counts.uniq_raw.txt.gz" ).linesGzip, 'gene' ],
            ]
            // a few counts of each tool: [ feature, sample, value ]
            def cells             = [
                motus4: [ [ 'mOTUv4.0_000924', '2613_unordered', '6' ] ],
                motus3: [ [ 'ref_mOTU_v31_03626', '2613_unordered', '4' ] ],
                cayman: [ [ 'GH13', '2613_unordered', '9.0' ] ],
                gqlib:  [ [ 'GMGC10.266_871_379.GLGB', '2613_unordered', '8.0' ] ],
            ]
            assertAll(
                { assert workflow.success },
                { assert snapshot ( software_versions ).match( "software_versions" ) },
                { assert snapshot ( workflow.trace.succeeded().size() ).match( "number_of_tasks" ) },
                { assert snapshot ( stable_name ).match( "filenames" ) },
                { assert workflow.trace.succeeded().count { task -> task.name.contains( ":BBMAP_REPAIR (" ) } == 1 },
                // the input pairs are out of order: the mates of all but 3 of the 537544 pairs differ (and none with the
                // original second file, the control)
                { assert unsynced_pairs( "${input_dir}/ERX5474937_ERR5766181_1.fastq.gz", "${input_dir}/ERX5474937_ERR5766181_unordered_2.fastq.gz" ) == [ 537544, 537541 ] },
                { assert unsynced_pairs( "${input_dir}/ERX5474937_ERR5766181_1.fastq.gz", "${input_dir}/ERX5474937_ERR5766181_2.fastq.gz" ) == [ 537544, 0 ] },
                // the pairs given to the profilers are all in order, the 533421 pairs retained by host removal
                { assert unsynced_pairs( "${output_prefix}_1_repaired.fastq.gz", "${output_prefix}_2_repaired.fastq.gz" ) == [ 533421, 0 ] },
                // the same counts as for sample 2613 with the pairs in order (test_read_suffixes): no pair is lost
                { assert [ 'raw_reads', 'qc_reads', 'hostremoval_retained_pairs' ].collect { column -> count_of( column ) } == [ '1075088', '1067004', '533421' ] },
                // the counts should be close to those of sample 2613 in the other tests, whose pairs are in order
                // (bwa estimates the insert size from batches of reads, so the order of the pairs can change a few alignments)
                { assert snapshot ( read_counts ).match( "read_counts" ) },
                // the whole merged tables (a few rows with the test databases)
                { assert snapshot ( merged.collectEntries { tool, table -> [ tool, table[0] ] } ).match( "counts" ) },
                { assert merged.collectEntries { tool, table -> [ tool, samples_in( *table ).sort() ] } == merged.collectEntries { tool, _table -> [ tool, samples ] } },
                { assert cells.every { tool, tool_cells -> tool_cells.every { feature, sample, value -> cell_of( merged[tool][0], merged[tool][1], feature, sample ) == value } } },
            )
        }
    }
}

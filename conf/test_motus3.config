/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/taxprofiler -profile test_motus,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name                    = 'mOTUs Test profile'
    config_profile_description             = 'Minimal test to check mOTUs function'
    input                                  = "${projectDir}/assets/test-data/samplesheet.csv"
    // the test databases of all the profilers (only those of the profilers run are used), with paths relative to the nf-test launch directory (.nf-test/tests/<hash>/), as the samplesheet
    databases                              = "${projectDir}/assets/test-data/databases.csv"
    // the human mitochondrial genome, so that host removal is fast; its bowtie2 index is built by the pipeline
    hostremoval_reference                  = "${projectDir}/assets/test-data/data/hostremoval/NC_012920.1.fna.gz"
    perform_shortread_qc                   = true
    perform_shortread_hostremoval          = true
    run_profile_standardisation            = true
    perform_runmerging                     = true
    run_motus3                             = true
}
nextflow_pipeline {
    name "Test cayman"
    script "../main.nf"
    tag "pipeline"
    tag "test_cayman"
    profile "test_cayman"

    test("test_cayman") {
        when {
            params {
                outdir = "${outputDir}"
            }
        }

        then {
            def stable_name       = getAllFilesFromDir( params.outdir, includeDir: true , ignore: [ 'pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**' ], relative: true )
            def software_versions = removeNextflowVersion( "${params.outdir}/pipeline_info/zellerlab_flexprofiler_software_mqc_versions.yml" )
            // the commit of the pipeline code changes with every commit
            software_versions.Workflow.remove( "zellerlab/flexprofiler_commit" )
            def read_counts       = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t" ) as List }
            def cayman_profiles   = getAllFilesFromDir( "${params.outdir}/cayman", include: [ '**.cazy.txt.gz' ] )
            def cayman_merge_raw  = path( "${params.outdir}/cayman/merge/GMGC10.human-gut.95nr.0.5.percent.prevalence/cayman_v3/GMGC10.human-gut.95nr.0.5.percent.prevalence_cayman_v3.cazy.uniq_raw.txt.gz" )
            def cayman_merge_rpkm = path( "${params.outdir}/cayman/merge/GMGC10.human-gut.95nr.0.5.percent.prevalence/cayman_v3/GMGC10.human-gut.95nr.0.5.percent.prevalence_cayman_v3.cazy.uniq_rpkm.txt.gz" )
            // the samples of a merged table, from its header (the line starting with the name of its first column), without
            // the taxonomy column and the _db_mOTU suffix of the motus reports
            def samples_in        = { lines, first_column -> lines.find { line -> line.startsWith( "${first_column}\t" ) }.split( "\t" ).drop( 1 ).findAll { column -> !( column in [ "consensus_taxonomy", "Taxonomy" ] ) }.collect { column -> column - ~/_db_mOTU$/ } }
            // the value of a cell of a merged table, by feature (first column) and sample (column of the header, the line
            // starting with the name of the first column)
            def cell_of           = { lines, first_column, feature, sample ->
                def header = lines.find { line -> line.startsWith( "${first_column}\t" ) }.split( "\t" ).collect { column -> column - ~/_db_mOTU$/ }
                lines.find { line -> line.startsWith( "${feature}\t" ) }.split( "\t" )[ header.indexOf( sample ) ]
            }
            def samples           = [ '2612', '2612_se', '2613' ]
            assertAll(
                { assert workflow.success },
                { assert snapshot ( software_versions ).match( "software_versions" ) },
                { assert snapshot ( workflow.trace.succeeded().size() ).match( "number_of_tasks" ) },
                { assert snapshot ( stable_name ).match( "filenames" ) },
                { assert snapshot ( read_counts ).match( "read_counts" ) },
                // the whole merged tables (a few rows with the test catalogue), raw counts and rpkm
                { assert snapshot ( cayman_merge_raw.linesGzip, cayman_merge_rpkm.linesGzip ).match( "counts" ) },
                { assert [ cayman_merge_raw, cayman_merge_rpkm ].collect { table -> samples_in( table.linesGzip, 'feature' ).sort() } == [ samples ] * 2 },
                // a few counts of each normalisation: [ feature, sample, value ]
                { assert [
                    ( cayman_merge_raw ):  [ [ 'GH13', '2612', '27.0' ], [ 'GH13', '2612_se', '12.0' ], [ 'GH13', '2613', '9.0' ], [ 'CBM48', '2613', '5.5' ] ],
                    ( cayman_merge_rpkm ): [ [ 'GH13', '2612', '957307.46403' ], [ 'GH13', '2612_se', '1338490.8209' ], [ 'GH13', '2613', '950144.28685' ], [ 'CBM48', '2613', '751366.12022' ] ],
                ].every { table, table_cells -> table_cells.every { feature, sample, value -> cell_of( table.linesGzip, 'feature', feature, sample ) == value } } },
                { assert snapshot (
                    cayman_profiles.collect { file -> "${file.getName()} contains 'total_reads': " + path( file.toString() ).linesGzip.any { it.startsWith( "total_reads\t" ) } },
                    cayman_profiles.collect { file -> "${file.getName()} contains 'GH13': " + path( file.toString() ).linesGzip.any { it.startsWith( "GH13\t" ) } },
                    getAllFilesFromDir( "${params.outdir}/cayman", include: [ '**.log' ] ).collect { file -> "${file.getName()} contains 'Finished.': " + file.text.contains( "Finished." ) },
                ).match("cayman") },
            )
        }
    }

    // a sample of which no read aligns or is classified: one read pair and one single-end read of random bases
    test("test_cayman_no_hits") {
        when {
            params {
                outdir = "${outputDir}"
                input  = "${baseDir}/assets/test-data/samplesheet_no_hits.csv"
            }
        }

        then {
            def samples     = [ 'no_hits_pe', 'no_hits_se' ]
            def read_counts = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t", -1 ) as List }
            def count_of    = { sample, column -> read_counts.find { row -> row[0] == sample }[read_counts[0].indexOf( column )] }
            def prefix           = "GMGC10.human-gut.95nr.0.5.percent.prevalence_cayman_v3"
            def cayman_dir       = "${params.outdir}/cayman/profile/GMGC10.human-gut.95nr.0.5.percent.prevalence/cayman_v3"
            def cayman_merge_dir = "${params.outdir}/cayman/merge/GMGC10.human-gut.95nr.0.5.percent.prevalence/cayman_v3"
            def cayman_merge     = { norm -> path( "${cayman_merge_dir}/${prefix}.cazy.uniq_${norm}.txt.gz" ).linesGzip }
            assertAll(
                { assert workflow.success },
                // for each sample, the CAZy table and the gene counts with only their header: gqlib writes no table of the
                // CAZy domains, and gqlib_patch.py makes it write the gene counts
                { assert getAllFilesFromDir( cayman_dir, include: [ '*.txt.gz' ] ).collect { file -> file.getName() }.sort() == samples.collectMany { sample -> [ 'aln_stats', 'cazy', 'gene_counts' ].collect { kind -> "${sample}_${prefix}.${kind}.txt.gz".toString() } } },
                { assert samples.every { sample -> path( "${cayman_dir}/${sample}_${prefix}.cazy.txt.gz" ).linesGzip == [ "feature\tuniq_raw\tuniq_rpkm" ] } },
                { assert samples.every { sample -> path( "${cayman_dir}/${sample}_${prefix}.gene_counts.txt.gz" ).linesGzip == [ "gene\tuniq_raw\tuniq_rpkm" ] } },
                { assert samples.every { sample -> path( "${cayman_dir}/${sample}_${prefix}.aln_stats.txt.gz" ).linesGzip == [ "Total\t0", "Passed\t0", "Seqid\t0", "Length\t0" ] } },
                { assert samples.every { sample -> def log_text = path( "${cayman_dir}/${sample}_${prefix}.cayman.log" ).text; log_text.contains( "No alignments present in stream." ) && log_text.contains( "Finished." ) } },
                // the merged tables, raw counts and rpkm: the two samples, and no feature
                { assert [ 'raw', 'rpkm' ].every { norm -> cayman_merge( norm ) == [ "feature\tno_hits_pe\tno_hits_se" ] } },
                // the reads reach the profiler (each mate counted), which counts none of them
                { assert read_counts.collect { row -> row[0] } == [ 'sample' ] + samples },
                { assert samples.collect { sample -> [ count_of( sample, 'hostremoval_retained_pairs' ), count_of( sample, 'profiler_input_reads' ), count_of( sample, 'cayman_GMGC10.human-gut.95nr.0.5.percent.prevalence_pairs' ) ] } == [ [ '1', '2', '0' ], [ '1', '1', '0' ] ] },
                { assert snapshot ( read_counts ).match( "read_counts_no_hits" ) },
                { assert snapshot ( cayman_merge( 'raw' ), cayman_merge( 'rpkm' ) ).match( "counts_no_hits" ) },
            )
        }
    }
}

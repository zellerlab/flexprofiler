nextflow_pipeline {
    name "Test motus3"
    script "../main.nf"
    tag "pipeline"
    tag "test_motus3"
    profile "test_motus3"

    test("test_motus3") {
        when {
            params {
                outdir = "${outputDir}"
            }
        }

        then {
            def stable_name       = getAllFilesFromDir( params.outdir, includeDir: true , ignore: [ 'pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**' ], relative: true )
            def software_versions = removeNextflowVersion( "${params.outdir}/pipeline_info/zellerlab_flexprofiler_software_mqc_versions.yml" )
            // the commit of the pipeline code changes with every commit
            software_versions.Workflow.remove( "zellerlab/flexprofiler_commit" )
            def read_counts       = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t" ) as List }
            def motus3_merge      = file( "${params.outdir}/motus3/merge/motus3_db_mOTU_combined_reports.txt" )
            def collinsella_aerofaciens_mOTU = "ref_mOTU_v31_03626\tk__Bacteria|p__Actinobacteria|c__Coriobacteriia|o__Coriobacteriales|f__Coriobacteriaceae|g__Collinsella|s__Collinsella aerofaciens [Collinsella sp. CAG:166/Collinsella sp. 4_8_47FAA/Collinsella aerofaciens]"
            // the samples of a merged table, from its header (the line starting with the name of its first column), without
            // the taxonomy column and the _db_mOTU suffix of the motus reports
            def samples_in        = { lines, first_column -> lines.find { line -> line.startsWith( "${first_column}\t" ) }.split( "\t" ).drop( 1 ).findAll { column -> !( column in [ "consensus_taxonomy", "Taxonomy" ] ) }.collect { column -> column - ~/_db_mOTU$/ } }
            // the value of a cell of a merged table, by feature (first column) and sample (column of the header, the line
            // starting with the name of the first column)
            def cell_of           = { lines, first_column, feature, sample ->
                def header = lines.find { line -> line.startsWith( "${first_column}\t" ) }.split( "\t" ).collect { column -> column - ~/_db_mOTU$/ }
                lines.find { line -> line.startsWith( "${feature}\t" ) }.split( "\t" )[ header.indexOf( sample ) ]
            }
            def samples           = [ '2612', '2612_se', '2613' ]
            assertAll(
                { assert workflow.success },
                { assert snapshot ( software_versions ).match( "software_versions" ) },
                { assert snapshot ( workflow.trace.succeeded().size() ).match( "number_of_tasks" ) },
                { assert snapshot ( stable_name ).match( "filenames" ) },
                { assert snapshot ( read_counts ).match( "read_counts" ) },
                // the whole merged report (the four mOTUs of the test database and the unassigned)
                { assert snapshot ( motus3_merge.readLines() ).match( "counts" ) },
                { assert samples_in( motus3_merge.readLines(), '#mOTU' ).sort() == samples },
                // a few counts: [ mOTU, sample, value ]
                { assert [ [ 'ref_mOTU_v31_03626', '2612', '7' ], [ 'ref_mOTU_v31_03626', '2613', '4' ], [ 'ref_mOTU_v31_03695', '2612_se', '3' ] ].every { motu, sample, value -> cell_of( motus3_merge.readLines(), '#mOTU', motu, sample ) == value } },
                { assert snapshot (
                    getAllFilesFromDir( "${params.outdir}/motus3", include: [ '**.out' ] ).collect { file -> "${file.getName()} contains '${collinsella_aerofaciens_mOTU}' " + file.text.contains( collinsella_aerofaciens_mOTU ) },
                    getAllFilesFromDir( "${params.outdir}/motus3", include: [ '**.out' ] ).collect { file -> "${file.getName()} contains 'unassigned' " + file.text.contains( "unassigned" ) },
                    getAllFilesFromDir( "${params.outdir}/motus3", include: [ '**.log' ] ).collect { file -> "${file.getName()} contains 'Finished computation': " + file.text.contains( "Finished computation" ) },
                ).match("motus3") },
            )
        }
    }

    // a sample of which no read aligns or is classified: one read pair and one single-end read of random bases
    test("test_motus3_no_hits") {
        when {
            params {
                outdir = "${outputDir}"
                input  = "${baseDir}/assets/test-data/samplesheet_no_hits.csv"
            }
        }

        then {
            def samples     = [ 'no_hits_pe', 'no_hits_se' ]
            def read_counts = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t", -1 ) as List }
            def count_of    = { sample, column -> read_counts.find { row -> row[0] == sample }[read_counts[0].indexOf( column )] }
            def motus3_dir   = "${params.outdir}/motus3/profile/db_mOTU"
            def motus3_merge = path( "${params.outdir}/motus3/merge/motus3_db_mOTU_combined_reports.txt" ).readLines()
            // the mOTUs of the test database, in the order of the profiles
            def motus        = [ 'ref_mOTU_v31_03379', 'ref_mOTU_v31_03626', 'ref_mOTU_v31_03695', 'ext_mOTU_v31_17631', 'unassigned' ]
            // the rows of a profile or merged table (not the comment lines): the mOTU and the given columns
            def rows_of      = { lines, columns -> lines.findAll { line -> !line.startsWith( "#" ) }.collect { line -> def fields = line.split( "\t" ); [ fields[0] ] + columns.collect { column -> fields[column] } } }
            assertAll(
                { assert workflow.success },
                // a profile for each sample, with all the mOTUs of the database at 0
                { assert getAllFilesFromDir( motus3_dir, include: [ '*.out' ] ).collect { file -> file.getName() }.sort() == samples.collect { sample -> "${sample}_db_mOTU.out".toString() } },
                { assert samples.every { sample -> path( "${motus3_dir}/${sample}_db_mOTU.out" ).readLines().find { line -> line.startsWith( "#mOTU\t" ) } == "#mOTU\tconsensus_taxonomy\t${sample}_db_mOTU".toString() } },
                { assert samples.every { sample -> rows_of( path( "${motus3_dir}/${sample}_db_mOTU.out" ).readLines(), [ 2 ] ) == motus.collect { motu -> [ motu, '0' ] } } },
                { assert samples.every { sample -> path( "${motus3_dir}/${sample}_db_mOTU.log" ).text.contains( "Total number of inserts: 0" ) } },
                // the merged table: all the mOTUs at 0 in the two samples
                { assert motus3_merge.find { line -> line.startsWith( "#mOTU\t" ) } == "#mOTU\tconsensus_taxonomy\tno_hits_pe_db_mOTU\tno_hits_se_db_mOTU" },
                { assert rows_of( motus3_merge, [ 2, 3 ] ) == motus.collect { motu -> [ motu, '0', '0' ] } },
                // the reads reach the profiler (each mate counted), which counts none of them
                { assert read_counts.collect { row -> row[0] } == [ 'sample' ] + samples },
                { assert samples.collect { sample -> [ count_of( sample, 'hostremoval_retained_pairs' ), count_of( sample, 'profiler_input_reads' ), count_of( sample, 'motus3_db_mOTU_pairs' ) ] } == [ [ '1', '2', '0' ], [ '1', '1', '0' ] ] },
                { assert snapshot ( read_counts ).match( "read_counts_no_hits" ) },
                { assert snapshot ( motus3_merge ).match( "counts_no_hits" ) },
            )
        }
    }
}

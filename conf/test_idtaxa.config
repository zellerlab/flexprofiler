/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run zellerlab/flexprofiler -profile test_idtaxa,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name                    = 'IDTAXA Test profile'
    config_profile_description             = 'Minimal test to check IDTAXA function on 16S amplicon reads'
    // 16S reads simulated from the reference sequences of the test training set (see assets/test-data/README.md)
    input                                  = "${projectDir}/assets/test-data/samplesheet_amplicon.csv"
    // the test databases of all the profilers (only those of the profilers run are used), with paths relative to the nf-test launch directory (.nf-test/tests/<hash>/), as the samplesheet
    databases                              = "${projectDir}/assets/test-data/databases.csv"
    perform_shortread_qc                   = true
    run_profile_standardisation            = true
    perform_runmerging                     = true
    run_idtaxa                             = true
}

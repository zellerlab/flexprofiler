/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing the PathSeq-T2T host filtering (--pathseq_t2t)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The references are small parts of the human mitochondrial genome, made with
    assets/test-data/scripts/make_pathseq_t2t_data.py (see assets/test-data/README.md).

    Use as follows:
        nextflow run zellerlab/flexprofiler -profile test_pathseq_t2t,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name          = 'PathSeq-T2T test profile'
    config_profile_description   = 'Minimal test to check the PathSeq-T2T host filtering'
    input                        = "${projectDir}/assets/test-data/samplesheet_pathseq_t2t.csv"
    databases                    = "${projectDir}/assets/test-data/databases.csv"
    pathseq_t2t                  = true
    pathseq_t2t_grch38_reference = "${projectDir}/assets/test-data/data/pathseq_t2t/grch38_test.fna.gz"
    pathseq_t2t_chm13_reference  = "${projectDir}/assets/test-data/data/pathseq_t2t/t2t_test.fna.gz"
    pathseq_host_dir             = "${projectDir}/assets/test-data/data/pathseq_t2t/pathseq_host"
    pathseq_decoys_bed           = "${projectDir}/assets/test-data/data/pathseq_t2t/decoys_test.bed"
    perform_runmerging           = true
    // the test Kraken2 database, of the microbial and decoy genomes of the reads
    run_kraken2                  = true
    // only the database of the microbial and decoy genomes (test_kraken2_wgs is that of the WGS test reads)
    kraken2_db_names             = 'test_kraken2_pathseq'
    run_profile_standardisation  = true
}

process {
    // the test references are tiny
    withName: 'PATHSEQT2T_QCFILTER' {
        cpus   = 2
        memory = 4.GB
    }
    withName: 'BWA_INDEX_GRCH38|BWA_INDEX_T2T|PATHSEQT2T_T2TFILTER' {
        cpus   = 2
        memory = 2.GB
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    zellerlab/flexprofiler Nextflow config file specific for the Zeller lab
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    This config file sets useful defaults for use by the Zellerlab.
    Use the profile "zellerlab_shark" for setting the right paths etc for the
    LUMC shark cluster
----------------------------------------------------------------------------------------
*/

profiles {
    // the ALICE cluster (Leiden University). The databases are copies of those of SHARK, with the same layout under
    // /projects/pi-zeller/SHARED/flexprofiler_databases, made by utils/sync_databases_alice.sh, which also writes the database
    // sheet (assets/zellerlab_alice_databases.csv) with only the databases copied so far. The inputs are staged from
    // SHARK, and the results copied back, by utils/run_alice.sh
    zellerlab_alice {
        // as in zellerlab_shark: the containers are run with apptainer, from a cache shared by the lab
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = '/projects/pi-zeller/SHARED/flexprofiler/apptainer'
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        params {
            databases = "${projectDir}/assets/zellerlab_alice_databases.csv"
            // We use the T2T genome for host removal as recommended in https://doi.org/10.1016/j.crmeth.2025.101218
            hostremoval_reference = "/projects/pi-zeller/SHARED/flexprofiler_databases/host_genome/t2t_chm13v2/GCF_009914755.1_T2T-CHM13v2.0_genomic.fna.gz"
            shortread_hostremoval_index = "/projects/pi-zeller/SHARED/flexprofiler_databases/host_genome/t2t_chm13v2/bowtie2_index"
            amplicon_orient_reference = "/projects/pi-zeller/SHARED/flexprofiler_databases/gtdb/r232.0/ssu_all.fna.gz"
            pathseq_t2t_grch38_bwa_index  = "/projects/pi-zeller/SHARED/flexprofiler_databases/pathseq_t2t/grch38_d1_vd1/bwa"
            pathseq_t2t_grch38_star_index = "/projects/pi-zeller/SHARED/flexprofiler_databases/pathseq_t2t/grch38_d1_vd1/star"
            pathseq_t2t_chm13_bwa_index   = "/projects/pi-zeller/SHARED/flexprofiler_databases/pathseq_t2t/t2t_chm13v2/bwa"
            pathseq_host_dir              = "/projects/pi-zeller/SHARED/flexprofiler_databases/pathseq_t2t/pathseq_host"
        }
        process {
            cache = "lenient"
            // each task is offered to all the partitions it fits and starts in the first one with room. The limits
            // (ALICE, 2026-11-17; the per-user CPU limits are those of the partition QOS):
            //   cpu-short    4 h, at most 64 CPUs per node, nodes of 48-128 CPUs / >= 371 GB; 324 CPUs per user
            //   cpu-skylake  7 days, nodes of 48 CPUs / 371 GB; 192 CPUs per user
            //   cpu-zen4     7 days, nodes of 128 CPUs / 375 GB; 256 CPUs per user
            //   mem          14 days, 2 nodes of >= 48 CPUs / >= 2 TB; 128 CPUs per user
            // The gpu-* partitions reject jobs that request no GPU, and testing and interactive allow 4 jobs per user,
            // so they are left out. The partition is not part of the task hash, so -resume is not affected
            queue = {
                def cpus = task.cpus ?: 1
                def mem  = task.memory ?: 4.GB * cpus
                def time = task.time ?: 1.h
                def partitions = []
                if (time <= 4.h && cpus <= 64  && mem <= 370.GB) { partitions << 'cpu-short' }
                if (cpus <= 48  && mem <= 370.GB) { partitions << 'cpu-skylake' }
                if (cpus <= 128 && mem <= 370.GB) { partitions << 'cpu-zen4' }
                if (time <= 14.d && cpus <= 48) { partitions << 'mem' }
                partitions ? partitions.join(',') : 'mem'
            }
            executor = 'slurm'
            scratch = '/scratchdata/${USER}/${SLURM_JOBID}'
            errorStrategy = {
                if (task.exitStatus in [132, 135, 255] ) {
                    sleep(Math.pow(2, task.attempt) * 200 as long)
                    return 'retry'
                }

                if (task.exitStatus in ((130..145) + 104 + 175)) {
                    return task.attempt <= 3 ? 'retry' : 'finish'
                }
                
                return 'finish'
            }
            maxRetries = 10
        }
        executor {
            queueSize = 1000
            submitRateLimit = "5sec"
            // sbatch is never run twice for a task: when it times out the job can be submitted anyway, and a second
            // sbatch would run a second job in the same work directory. utils/sbatch_wrapper/sbatch (put in PATH by the
            // launchers) waits for the job to show up instead, and fails if it does not, failing the pipeline
            retry.maxAttempts = 1
        }
    }
    zellerlab_shark {
        // the containers are run with apptainer, as the apptainer profile (nextflow.config) does, so that it does not
        // need to be given too: a profile cannot include another
        apptainer.enabled    = true
        apptainer.autoMounts = true
        // shared by the lab, so that each image is pulled once: it overrides the cacheDir of ~/.nextflow/config
        apptainer.cacheDir   = '/exports/lucid-grpzeller-work/SOFTWARE_CACHE/flexprofiler/apptainer'
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        params {
            databases = "${projectDir}/assets/zellerlab_shark_databases.csv"
            // We use the T2T genome for host removal as recommended in https://doi.org/10.1016/j.crmeth.2025.101218
            hostremoval_reference = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/host_genome/t2t_chm13v2/GCF_009914755.1_T2T-CHM13v2.0_genomic.fna.gz"
            shortread_hostremoval_index = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/host_genome/t2t_chm13v2/bowtie2_index"
            // the GTDB 16S sequences (bacteria and archaea), to orient the long amplicon reads before PIMENTO
            amplicon_orient_reference = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/gtdb/r232.0/ssu_all.fna.gz"
            // the references of the PathSeq-T2T host filtering (zellerlab_pathseq_t2t), downloaded by
            // utils/fetch_missing_databases_shark.sh (only checked with --pathseq_t2t)
            pathseq_t2t_grch38_bwa_index  = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/pathseq_t2t/grch38_d1_vd1/bwa"
            // used with --pathseq_t2t_grch38_aligner star (zellerlab_pathseq_t2t_rna)
            pathseq_t2t_grch38_star_index = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/pathseq_t2t/grch38_d1_vd1/star"
            pathseq_t2t_chm13_bwa_index   = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/pathseq_t2t/t2t_chm13v2/bwa"
            pathseq_host_dir              = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/pathseq_t2t/pathseq_host"
            // with --large_scale (zellerlab_large_scale) only: each run that processes a batch submits the sbatch script
            // of its SLURM job again, for the next batch (an error if not run in a job submitted with `sbatch <script>`:
            // --large_scale_slurm_resubmit false to run the batches by hand)
            large_scale_slurm_resubmit    = true
        }
        process {
            cache = "lenient"
            executor = 'slurm'
            // each task is offered to all the partitions it fits and starts in the first one with room. The limits
            // (SHARK, 2026-11-17):
            //   all, highmem    30 days, nodes up to 128 CPUs / 4 TB; highmem has nodes outside `all` (exe032-033)
            //   short           1 h; nodes outside `all` (path01-03, kno01)
            //   medium          4 h, and its QOS (restrictmedium) allows at most 4 CPUs and 8 GB per user in all
            //   gpu             10 h, at most 18 CPUs per node, nodes up to 754 GB; higher priority tier;
            //                   nodes outside `all` (gpu14-17)
            //   gpu-medium      2 days, nodes up to 64 CPUs / 754 GB; gpu07-08 outside `all`
            //   gpu-long        7 days, nodes up to 64 CPUs / 754 GB; gpu10-12 outside `all`
            //   gpu-short       30 min, at most 4 CPUs per node, nodes up to 754 GB
            // The partition is not part of the task hash, so -resume is not affected
            queue = {
                def cpus = task.cpus ?: 1
                def mem  = task.memory ?: 2.GB * cpus
                def time = task.time ?: 1.h
                def gpu_node = mem <= 740.GB
                def partitions = ['all', 'highmem']
                if (time <= 7.d  && cpus <= 64 && gpu_node) { partitions << 'gpu-long' }
                if (time <= 2.d  && cpus <= 64 && gpu_node) { partitions << 'gpu-medium' }
                if (time <= 10.h && cpus <= 18 && gpu_node) { partitions << 'gpu' }
                if (time <= 30.m && cpus <= 4  && gpu_node) { partitions << 'gpu-short' }
                if (time <= 4.h  && cpus <= 4  && mem <= 8.GB) { partitions << 'medium' }
                if (time <= 1.h) { partitions << 'short' }
                partitions.join(',')
            }
            // motus fails on this node, probably older CPU instruction set
            clusterOptions = '--exclude=res-hpc-mem02'
            errorStrategy = {
                if (task.exitStatus in [132, 135, 255] ) {
                    sleep(Math.pow(2, task.attempt) * 200 as long)
                    return 'retry'
                }

                if (task.exitStatus in ((130..145) + 104 + 175)) {
                    return task.attempt <= 3 ? 'retry' : 'finish'
                }

                return 'finish'
            }
            maxRetries = 10
            // PathSeqFilterSpark writes its Spark shuffle and spill files to tmp/ in the task directory: on the NFS
            // work directory it waits on I/O most of the time (~15% CPU, a median of ~9 h per sample), in the
            // node-local /tmp ($TMPDIR) it takes ~0.5-1.5 h. Only the outputs are copied back to the work directory.
            // --tmp reserves the local disk (one node has only 30 GB); the exclude above is repeated, as
            // clusterOptions replaces it. Neither is part of the task hash, so -resume still reuses the tasks run
            // without them
            withName: PATHSEQT2T_QCFILTER {
                scratch        = true
                clusterOptions = '--exclude=res-hpc-mem02 --tmp=100G'
            }
        }
        executor {
            queueSize = 100
            submitRateLimit = "5sec"
            // sbatch is never run twice for a task: when it times out the job can be submitted anyway, and a second
            // sbatch would run a second job in the same work directory. utils/sbatch_wrapper/sbatch (put in PATH by the
            // launchers) waits for the job to show up instead, and fails if it does not, failing the pipeline
            retry.maxAttempts = 1
        }
    }
    zellerlab_metagenomics {
        params{
            perform_shortread_qc = true
            perform_shortread_hostremoval = true
            run_profile_standardisation = true
            perform_runmerging = true
        }
    }
    zellerlab_amplicon {
        params{
            perform_shortread_qc = true
            // the vsearch quality filter of the PacBio reads
            perform_longread_qc = true
            perform_amplicon_primertrimming = true
            amplicon_pair_handling = 'merged_plus_joined'
            // GTDB R220, the taxonomy of mOTUs 4.0 (run_motus4)
            idtaxa_db_names = 'gtdb_r220_motus4.0'
            // a merged table for the genus only, besides the one of the whole lineages
            idtaxa_ranks = 'genus'
            run_profile_standardisation = true
            perform_runmerging = true
        }
    }
    zellerlab_pathseq_t2t {
        // the PathSeq-T2T host filtering of low-biomass human samples (docs/pathseq_t2t.md), with Kraken2: to use
        // instead of zellerlab_metagenomics, whose host removal it replaces. The adapters are trimmed by fastp first
        // (only the trimming, PathSeqFilterSpark filtering the reads by quality). The paths of the references are set
        // by the cluster profile (zellerlab_shark), the Kraken2 database by its database sheet
        params {
            pathseq_t2t                 = true
            perform_shortread_qc        = true
            perform_runmerging          = true
            run_profile_standardisation = true
        }
    }
    zellerlab_pathseq_t2t_rna {
        // as zellerlab_pathseq_t2t, for RNA-seq: the reads are aligned to GRCh38 with STAR, which also counts the reads
        // per host gene (docs/pathseq_t2t.md#rna-seq-star). The adapters are trimmed by fastp first, as in
        // zellerlab_pathseq_t2t. The STAR index of GRCh38, the T2T-CHM13 index and the PathSeq host files are set by the
        // cluster profile (zellerlab_shark)
        params {
            pathseq_t2t                   = true
            perform_shortread_qc          = true
            pathseq_t2t_grch38_aligner    = 'star'
            pathseq_t2t_merge_gene_counts = true
            perform_runmerging            = true
            run_profile_standardisation   = true
        }
    }
    zellerlab_minimal {
        params{
            skip_preprocessing_qc = true
            skip_postprocessing_qc = true
            skip_hostremoval_qc = true
            skip_multiqc = true
        }
    }
    zellerlab_large_scale {
        // large datasets (thousands of samples), processed one batch at a time (the processing_batch column of the
        // samplesheet), one batch per run, so that the work directory holds the intermediate files of one batch: each run
        // processes the next batch not done (the smallest), and deletes the task directories of the batches done
        // before; the run after the last batch makes the tables of all the samples (merged profiles, read counts). Run
        // the same command, with -resume and the same --outdir, until it reports that nothing is left to do (see
        // docs/zellerlab.md). No QC reports or MultiQC, as zellerlab_minimal
        params {
            large_scale                 = true
            // the run after the last batch merges the profiles of all the batches (an error without it)
            run_profile_standardisation = true
            skip_preprocessing_qc       = true
            skip_postprocessing_qc      = true
            skip_hostremoval_qc         = true
            skip_multiqc                = true
        }
        // the trace also gives the work directory of each task (of the cached ones too), so that those of a batch can
        // be deleted once it is done
        trace.fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir'
    }
    debug {
        lineage.enabled = true
    }
}

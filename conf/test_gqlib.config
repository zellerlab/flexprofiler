/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/taxprofiler -profile test_gqlib,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name                    = 'gqlib Test profile'
    config_profile_description             = 'Minimal test to check gqlib function'
    input                                  = "${projectDir}/assets/test-data/samplesheet.csv"
    perform_shortread_qc                   = true
    perform_shortread_hostremoval          = true
    run_profile_standardisation            = true
    perform_runmerging                     = true
    run_gqlib                              = true
}
/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing Kraken2 without PathSeq-T2T
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The reads of the PathSeq-T2T test (assets/test-data/scripts/make_pathseq_t2t_data.py),
    through the short-read QC and the host removal, against the human mitochondrial
    genome, which their host reads are from, then Kraken2 with the test database of their
    microbial and decoy genomes.

    Use as follows:
        nextflow run zellerlab/flexprofiler -profile test_kraken2,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name           = 'Kraken2 test profile'
    config_profile_description    = 'Minimal test to check Kraken2 after the short-read QC and host removal'
    input                         = "${projectDir}/assets/test-data/samplesheet_pathseq_t2t.csv"
    databases                     = "${projectDir}/assets/test-data/databases.csv"
    hostremoval_reference         = "${projectDir}/assets/test-data/data/hostremoval/NC_012920.1.fna.gz"
    perform_shortread_qc          = true
    perform_shortread_hostremoval = true
    perform_runmerging            = true
    run_kraken2                   = true
    run_profile_standardisation   = true
}

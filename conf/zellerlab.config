/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    zellerlab/flexprofiler Nextflow config file specific for the Zeller lab
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    This config file sets useful defaults for use by the Zellerlab.
    Use the profile "zellerlab_shark" for setting the right paths etc for the
    LUMC shark cluster
----------------------------------------------------------------------------------------
*/

profiles {
    // INCOMPLETE, for testing only: the ALICE cluster has only the mOTUs v4 database (assets/zellerlab_alice_databases.csv),
    // no reference to orient the long amplicon reads (amplicon_orient_reference), and no container engine set (give
    // -profile apptainer or singularity)
    zellerlab_alice {
        params {
            databases = "${projectDir}/assets/zellerlab_alice_databases.csv"
            // We use the T2T genome for host removal as recommended in https://doi.org/10.1016/j.crmeth.2025.101218
            hostremoval_reference = '/home/spierotti/flexprofiler_databases/host_genome/t2t_chm13v2/GCF_009914755.1_T2T-CHM13v2.0_genomic.fna.gz'
            shortread_hostremoval_index = '/home/spierotti/flexprofiler_databases/host_genome/t2t_chm13v2/bowtie2_index'
        }
        process {
            cache = "lenient"
            queue = {
                task.memory > 384.GB ? 'mem' : 
                task.time <= 4.h ? 'cpu-short' :
                task.cpus > 24 ? 'cpu-zen4' : 'cpu-skylake'
            }
            executor = 'slurm'
            scratch = '/scratchdata/${USER}/${SLURM_JOBID}'
            errorStrategy = {
                if (task.exitStatus in [132, 135, 255] ) {
                    sleep(Math.pow(2, task.attempt) * 200 as long)
                    return 'retry'
                }

                if (task.exitStatus in ((130..145) + 104 + 175)) {
                    return task.attempt <= 3 ? 'retry' : 'finish'
                }
                
                return 'finish'
            }
            maxRetries = 10
        }
        executor {
            queueSize = 1000
            submitRateLimit = "5sec"
        }
    }
    zellerlab_shark {
        // the containers are run with apptainer, as the apptainer profile (nextflow.config) does, so that it does not
        // need to be given too: a profile cannot include another
        apptainer.enabled    = true
        apptainer.autoMounts = true
        // shared by the lab, so that each image is pulled once: it overrides the cacheDir of ~/.nextflow/config
        apptainer.cacheDir   = '/exports/lucid-grpzeller-work/SOFTWARE_CACHE/flexprofiler/apptainer'
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        params {
            databases = "${projectDir}/assets/zellerlab_shark_databases.csv"
            // We use the T2T genome for host removal as recommended in https://doi.org/10.1016/j.crmeth.2025.101218
            hostremoval_reference = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/host_genome/t2t_chm13v2/GCF_009914755.1_T2T-CHM13v2.0_genomic.fna.gz"
            shortread_hostremoval_index = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/host_genome/t2t_chm13v2/bowtie2_index"
            // the GTDB 16S sequences (bacteria and archaea), to orient the long amplicon reads before PIMENTO
            amplicon_orient_reference = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/gtdb/r232.0/ssu_all.fna.gz"
            // the references of the PathSeq-T2T host filtering (zellerlab_pathseq_t2t), downloaded by
            // utils/fetch_missing_databases_shark.sh (only checked with --pathseq_t2t)
            pathseq_t2t_grch38_bwa_index  = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/pathseq_t2t/grch38_d1_vd1/bwa"
            // used with --pathseq_t2t_grch38_aligner star (zellerlab_pathseq_t2t_rna)
            pathseq_t2t_grch38_star_index = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/pathseq_t2t/grch38_d1_vd1/star"
            pathseq_t2t_chm13_bwa_index   = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/pathseq_t2t/t2t_chm13v2/bwa"
            pathseq_host_dir              = "/exports/archive/lucid-grpzeller-primary/SHARED/DATA/flexprofiler_databases/pathseq_t2t/pathseq_host"
        }
        process {
            cache = "lenient"
            executor = 'slurm'
            // motus fails on this node, probably older CPU instruction set
            clusterOptions = '--exclude=res-hpc-mem02'
            errorStrategy = {
                if (task.exitStatus in [132, 135, 255] ) {
                    sleep(Math.pow(2, task.attempt) * 200 as long)
                    return 'retry'
                }

                if (task.exitStatus in ((130..145) + 104 + 175)) {
                    return task.attempt <= 3 ? 'retry' : 'finish'
                }
                
                return 'finish'
            }
            maxRetries = 10
        }
        executor {
            queueSize = 1000
            submitRateLimit = "5sec"
        }
    }
    zellerlab_metagenomics {
        params{
            perform_shortread_qc = true
            perform_shortread_hostremoval = true
            run_profile_standardisation = true
            perform_runmerging = true
        }
    }
    zellerlab_amplicon {
        params{
            perform_shortread_qc = true
            // the vsearch quality filter of the PacBio reads
            perform_longread_qc = true
            perform_amplicon_primertrimming = true
            amplicon_pair_handling = 'merged_plus_joined'
            // GTDB R220, the taxonomy of mOTUs 4.0 (run_motus4)
            idtaxa_db_names = 'gtdb_r220_motus4.0'
            // a merged table for the genus only, besides the one of the whole lineages
            idtaxa_ranks = 'genus'
            run_profile_standardisation = true
            perform_runmerging = true
        }
    }
    zellerlab_pathseq_t2t {
        // the PathSeq-T2T host filtering of low-biomass human samples (docs/pathseq_t2t.md), with Kraken2: to use
        // instead of zellerlab_metagenomics, whose QC and host removal it replaces. The paths of the references are set
        // by the cluster profile (zellerlab_shark), the Kraken2 database by its database sheet
        params {
            pathseq_t2t                 = true
            perform_runmerging          = true
            run_profile_standardisation = true
        }
    }
    zellerlab_pathseq_t2t_rna {
        // as zellerlab_pathseq_t2t, for RNA-seq: the reads are aligned to GRCh38 with STAR, which also counts the reads
        // per host gene (docs/pathseq_t2t.md#rna-seq-star). The STAR index of GRCh38, the T2T-CHM13 index and the
        // PathSeq host files are set by the cluster profile (zellerlab_shark)
        params {
            pathseq_t2t                   = true
            pathseq_t2t_grch38_aligner    = 'star'
            pathseq_t2t_merge_gene_counts = true
            perform_runmerging            = true
            run_profile_standardisation   = true
        }
    }
    zellerlab_minimal {
        params{
            skip_preprocessing_qc = true
            skip_postprocessing_qc = true
            skip_hostremoval_qc = true
            skip_multiqc = true
        }
    }
    debug {
        lineage.enabled = true
    }
}

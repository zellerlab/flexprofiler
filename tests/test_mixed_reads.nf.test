nextflow_pipeline {
    name "Test a mix of normal, suffixed and unordered paired-end reads"
    script "../main.nf"
    tag "pipeline"
    tag "test_mixed_reads"
    profile "test_all"

    test("test_mixed_reads") {
        when {
            params {
                // the reads of sample 2613 as they are, with the /1 and /2 suffixes in the read names, with the pairs
                // in a different order, and both in two runs of a sample, merged; and single-end reads
                input                   = "${baseDir}/assets/test-data/samplesheet_mixed.csv"
                outdir                  = "${outputDir}"
                perform_repair_pe_order = true
                motus4_rename_reads     = true
            }
        }

        then {
            def stable_name       = getAllFilesFromDir( params.outdir, includeDir: true , ignore: [ 'pipeline_info/*.{html,json,txt}' ], relative: true )
            def software_versions = removeNextflowVersion( "${params.outdir}/pipeline_info/zellerlab_flexprofiler_software_mqc_versions.yml" )
            def read_counts       = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t" ) as List }
            def gene_catalogue    = "GMGC10.human-gut.95nr.0.5.percent.prevalence"
            // the rows of a table for some features (first column), and the same without the second column (the taxonomy of motus)
            def rows_of           = { lines, features -> lines.findAll { line -> line.split( "\t" )[0] in features } }
            def motus_rows_of     = { lines, motus -> rows_of( lines, motus ).collect { line -> line.split( "\t" ) as List }.collect { cols -> ( [ cols[0] ] + cols[2..-1] ).join( "\t" ) } }
            assertAll(
                { assert workflow.success },
                { assert snapshot ( software_versions ).match( "software_versions" ) },
                { assert snapshot ( workflow.trace.succeeded().size() ).match( "number_of_tasks" ) },
                { assert snapshot ( stable_name ).match( "filenames" ) },
                // the 5 paired-end runs are repaired, and the mates of the 4 paired-end samples renamed for motus4
                { assert workflow.trace.succeeded().count { task -> task.name.contains( "BBMAP_REPAIR" ) } == 5 },
                { assert workflow.trace.succeeded().count { task -> task.name.contains( "MOTUS4_RENAME_READS" ) } == 8 },
                // the suffixes in the read names change no count
                { assert read_counts.find { it[0] == "2613_suffixed" }.tail() == read_counts.find { it[0] == "2613" }.tail() },
                { assert snapshot ( read_counts ).match( "read_counts" ) },
                { assert snapshot (
                    motus_rows_of( file( "${params.outdir}/motus4/merge/motus4_db_mOTU_combined_reports.txt" ).readLines(), [ 'mOTU', 'mOTUv4.0_014686', 'mOTUv4.0_000924', 'mOTUv4.0_unassigned' ] ),
                    motus_rows_of( file( "${params.outdir}/motus3/merge/motus3_db_mOTU_combined_reports.txt" ).readLines(), [ '#mOTU', 'ref_mOTU_v31_03626', 'ref_mOTU_v31_03695', 'unassigned' ] ),
                    rows_of( path( "${params.outdir}/cayman/merge/${gene_catalogue}/cayman_v3/${gene_catalogue}_cayman_v3.cazy.uniq_raw.txt.gz" ).linesGzip, [ 'feature', 'total_reads', 'filtered_reads', 'GH13', 'CBM48' ] ),
                    rows_of( path( "${params.outdir}/gqlib/merge/${gene_catalogue}/emapper_v2.1.7/${gene_catalogue}_emapper_v2.1.7.gene_counts.uniq_raw.txt.gz" ).linesGzip, [ 'gene', 'GMGC10.266_871_379.GLGB', 'GMGC10.266_660_280.AMY' ] ),
                ).match( "counts" ) },
            )
        }
    }
}

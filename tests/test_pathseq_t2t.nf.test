nextflow_pipeline {
    name "Test the PathSeq-T2T host filtering (--pathseq_t2t)"
    script "../main.nf"
    tag "pipeline"
    tag "test_pathseq_t2t"
    profile "test_pathseq_t2t"

    // the reads of the fixture (assets/test-data/scripts/make_pathseq_t2t_data.py) are named by what they are: the
    // class of a read is its name without the numbers
    def read_classes = { file ->
        path( file.toString() ).linesGzip.withIndex()
            .findAll { _line, i -> i % 4 == 0 }
            .collect { line, _i -> line.substring( 1 ).split( /\s/ )[0].replaceAll( /(_\d+)+$/, '' ) }
    }
    // the classes that must all be removed: from the part of the host in "GRCh38" (alone, or the host mate of a
    // chimera) or only in "T2T-CHM13", of low complexity or quality, or too short
    def removed_classes = [ "grch38_pair", "grch38_pair2", "grch38_single", "t2t_pair", "t2t_single", "lowcomplexity_pair", "lowcomplexity_single", "lowquality_pair", "short_pair", "chimera_grch38_t2t" ]

    test("test_pathseq_t2t") {
        when {
            params {
                outdir                     = "${outputDir}"
                save_analysis_ready_fastqs = true
            }
        }

        then {
            def stable_name = getAllFilesFromDir( params.outdir, includeDir: true, ignore: [ 'pipeline_info/*.{html,json,txt}', 'pipeline_info/*_versions.yml', 'multiqc/**', 'falco/**' ], relative: true )
            def software_versions = removeNextflowVersion( "${params.outdir}/pipeline_info/zellerlab_flexprofiler_software_mqc_versions.yml" )
            // the commit of the pipeline code changes with every commit
            software_versions.Workflow.remove( "zellerlab/flexprofiler_commit" )
            def read_counts = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t" ) as List }
            def count = { sample, column -> read_counts.find { row -> row[0] == sample }[read_counts[0].indexOf( column )] as int }
            def out = "${params.outdir}/analysis_ready_fastqs"
            def pe_1 = read_classes( "${out}/lowbiomass.t2tfilt_1.fastq.gz" )
            def pe_2 = read_classes( "${out}/lowbiomass.t2tfilt_2.fastq.gz" )
            def singletons = read_classes( "${out}/lowbiomass.t2tfilt_unpaired.fastq.gz" )
            def se = read_classes( "${out}/lowbiomass_se.t2tfilt_unpaired.fastq.gz" )
            def tasks = workflow.trace.succeeded()*.name
            def kraken2_table = { name -> path( "${params.outdir}/kraken2/kraken2_test_kraken2_pathseq.${name}.tsv" ).readLines().collect { line -> line.split( "\t" ) as List } }
            def kraken2_clade = { taxid, sample ->
                def table = kraken2_table( "reads_clade" )
                table.find { row -> row[0] == taxid }[table[0].indexOf( sample )] as int
            }
            // the taxid of a species, by its name in the taxonomy table (taxid, name, rank, lineage)
            def kraken2_species = { name ->
                def species = kraken2_table( "taxonomy" ).find { row -> row[1] == name && row[2] == "S" }
                assert species : "no species '${name}' in the Kraken2 taxonomy table"
                species[0]
            }
            def samples = [ "lowbiomass", "lowbiomass_se" ]
            // the reads given to Kraken2 whose class matches (a closure on the class), as Kraken2 counts them: for the
            // paired-end sample the R1 and R2 mates of the pairs and the singletons, for the single-end sample its reads
            def kraken2_reads = { sample, matches ->
                if ( sample == "lowbiomass" ) {
                    return pe_1.count( matches ) + pe_2.count( matches ) + singletons.count( matches )
                } else if ( sample == "lowbiomass_se" ) {
                    return se.count( matches )
                } else {
                    throw new IllegalArgumentException( "unknown sample: ${sample}" )
                }
            }
            assertAll(
                { assert workflow.success },
                { assert snapshot ( workflow.trace.succeeded().size() ).match( "number_of_tasks" ) },
                { assert snapshot ( stable_name ).match( "filenames" ) },
                { assert snapshot ( software_versions ).match( "software_versions" ) },
                // the QC and host removal steps are not run
                { assert !tasks.any { name -> name =~ /FASTP|BBDUK|BOWTIE2/ } },
                // the two runs of the sample are filtered together (run merging)
                { assert tasks.count { name -> name.contains( "PATHSEQT2T_QCFILTER" ) } == 2 },
                // the reads that must be removed are all removed
                { assert ( pe_1 + pe_2 + singletons + se ).intersect( removed_classes ).isEmpty() },
                // the mates of the pairs are in sync
                { assert pe_1 == pe_2 },
                // the reads of the viral decoy contig are kept, as are the microbial mates of the chimeras with a host mate
                { assert pe_1.contains( "decoy_pair" ) && se.contains( "decoy_single" ) },
                { assert singletons.contains( "chimera_grch38r1_microbe" ) && singletons.contains( "chimera_grch38r2_microbe" ) },
                // one pair is kept of each group of duplicates, and the duplicates across the runs are removed with run
                // merging: none of the 10 is left as a pair (a mate can be left, its copy having lost its mate)
                { assert pe_1.count( "duplicate_pair" ) <= 10 && se.count( "duplicate_single" ) <= 10 },
                { assert pe_1.count( "crossrun_duplicate" ) == 0 },
                // the reads per step: the raw reads are the primary reads aligned to GRCh38, each mate counted
                { assert count( "lowbiomass", "raw_reads" ) == 2 * ( 1110 ) },
                { assert count( "lowbiomass_se", "raw_reads" ) == 840 },
                { assert count( "lowbiomass", "t2t_filter_reads" ) == 2 * pe_1.size() + singletons.size() },
                { assert count( "lowbiomass_se", "t2t_filter_reads" ) == se.size() },
                { assert snapshot ( read_counts ).match( "read_counts" ) },
                // Kraken2: the reads are counted once each, pairs as two reads and singletons as one, so that the
                // classified and unclassified reads add up to the filtered reads
                { assert kraken2_clade( "0", "lowbiomass" ) + kraken2_clade( "1", "lowbiomass" ) == count( "lowbiomass", "t2t_filter_reads" ) },
                { assert kraken2_clade( "0", "lowbiomass_se" ) + kraken2_clade( "1", "lowbiomass_se" ) == count( "lowbiomass_se", "t2t_filter_reads" ) },
                { assert kraken2_clade( "1", "lowbiomass" ) == count( "lowbiomass", "kraken2_test_kraken2_pathseq_reads" ) },
                // the reads of each species in every sample, by where they are from: those of the microbial genome are
                // classified as the bacterium, and those of the decoy contig as the virus
                { assert [ "Testella microbica", "Decoyvirus testi" ].collectEntries { name -> [ ( name ): samples.collectEntries { sample -> [ ( sample ): kraken2_clade( kraken2_species( name ), sample ) ] } ] } == [
                    "Testella microbica": samples.collectEntries { sample -> [ ( sample ): kraken2_reads( sample, { cls -> !cls.startsWith( "t2t" ) && !cls.startsWith( "decoy" ) } ) ] },
                    "Decoyvirus testi":   samples.collectEntries { sample -> [ ( sample ): kraken2_reads( sample, { cls -> cls.startsWith( "decoy" ) } ) ] },
                ] },
                // no read is left unclassified: the host reads are all removed, and the others are from the genomes of
                // the database
                { assert samples.collectEntries { sample -> [ ( sample ): kraken2_clade( "0", sample ) ] } == [ "lowbiomass": 0, "lowbiomass_se": 0 ] },
                { assert snapshot (
                    path( "${params.outdir}/kraken2/kraken2_test_kraken2_pathseq.reads_clade.tsv" ),
                    path( "${params.outdir}/kraken2/kraken2_test_kraken2_pathseq.reads_taxon.tsv" ),
                    path( "${params.outdir}/kraken2/kraken2_test_kraken2_pathseq.taxonomy.tsv" ),
                ).match( "kraken2_tables" ) },
            )
        }
    }

    test("test_pathseq_t2t_no_runmerging") {
        when {
            params {
                outdir             = "${outputDir}"
                perform_runmerging = false
            }
        }

        then {
            def tasks = workflow.trace.succeeded()*.name
            assertAll(
                { assert workflow.success },
                // each run is filtered on its own
                { assert tasks.count { name -> name.contains( "PATHSEQT2T_QCFILTER" ) } == 3 },
                { assert path( "${params.outdir}/pathseq_t2t/t2tfilter/lowbiomass_run1.t2tfilter.log" ).exists() },
                { assert path( "${params.outdir}/pathseq_t2t/t2tfilter/lowbiomass_run2.t2tfilter.log" ).exists() },
            )
        }
    }

    test("test_pathseq_t2t_empty_input") {
        when {
            params {
                outdir                     = "${outputDir}"
                input                      = "${baseDir}/assets/test-data/samplesheet_pathseq_t2t_empty.csv"
                save_analysis_ready_fastqs = true
            }
        }

        then {
            def read_counts = path( "${params.outdir}/read_counts/read_counts.tsv" ).readLines().collect { line -> line.split( "\t" ) as List }
            def count = { sample, column -> read_counts.find { row -> row[0] == sample }[read_counts[0].indexOf( column )] as int }
            def out = "${params.outdir}/analysis_ready_fastqs"
            def fastqs = [ "empty.t2tfilt_1.fastq.gz", "empty.t2tfilt_2.fastq.gz", "empty.t2tfilt_unpaired.fastq.gz", "empty_se.t2tfilt_unpaired.fastq.gz" ]
            assertAll(
                { assert workflow.success },
                // samples without reads go through every step, and give empty FASTQs
                { assert fastqs.every { name -> path( "${out}/${name}" ).exists() && path( "${out}/${name}" ).linesGzip.isEmpty() } },
                { assert [ "empty", "empty_se" ].every { sample -> count( sample, "raw_reads" ) == 0 && count( sample, "t2t_filter_reads" ) == 0 } },
            )
        }
    }

    test("test_pathseq_t2t_conflicting_steps") {
        when {
            params {
                outdir                        = "${outputDir}"
                perform_shortread_qc          = true
                perform_shortread_hostremoval = true
                hostremoval_reference         = "${baseDir}/assets/test-data/data/hostremoval/NC_012920.1.fna.gz"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { line -> line.contains( "--pathseq_t2t filters the reads as they were sequenced, and cannot be used with --perform_shortread_qc, --perform_shortread_hostremoval" ) } },
            )
        }
    }

    test("test_pathseq_t2t_unsupported_input") {
        when {
            params {
                outdir = "${outputDir}"
                input  = "${baseDir}/assets/test-data/samplesheet_pacbio.csv"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { line -> line.contains( "--pathseq_t2t accepts only ILLUMINA FASTQ of WGS runs" ) } },
            )
        }
    }

    test("test_pathseq_t2t_missing_reference") {
        when {
            params {
                outdir                       = "${outputDir}"
                pathseq_t2t_grch38_reference = null
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { line -> line.contains( "--pathseq_t2t needs GRCh38" ) } },
            )
        }
    }
}

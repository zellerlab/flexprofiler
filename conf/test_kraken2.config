/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing Kraken2 on WGS reads, without PathSeq-T2T
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The WGS test reads, through the short-read QC and the host removal, then Kraken2 with
    a database of the reference genomes of two species found in them (Methanobrevibacter
    smithii and Collinsella aerofaciens), made with
    assets/test-data/scripts/make_kraken2_wgs_db.sh (see assets/test-data/README.md).

    Use as follows:
        nextflow run zellerlab/flexprofiler -profile test_kraken2,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name           = 'Kraken2 test profile'
    config_profile_description    = 'Minimal test to check Kraken2 on WGS reads, after the short-read QC and host removal'
    input                         = "${projectDir}/assets/test-data/samplesheet.csv"
    // the test databases of all the profilers, of which only the Kraken2 database of this test (that of the PathSeq-T2T
    // test, test_kraken2_pathseq, would classify none of these reads)
    databases                     = "${projectDir}/assets/test-data/databases.csv"
    // the human mitochondrial genome, so that host removal is fast; its bowtie2 index is built by the pipeline
    hostremoval_reference         = "${projectDir}/assets/test-data/data/hostremoval/NC_012920.1.fna.gz"
    perform_shortread_qc          = true
    perform_shortread_hostremoval = true
    perform_runmerging            = true
    run_kraken2                   = true
    kraken2_db_names              = 'test_kraken2_wgs'
    run_profile_standardisation   = true
}

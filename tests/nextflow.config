/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

params {
    modules_testdata_base_path   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
}

// cap the resources, so that the tests can run on a laptop: with the test databases, no task needs more
// (the largest is mOTUs v4 profiling, with the full database, at ~14GB)
process {
    resourceLimits = [
        cpus: 8,
        memory: '20.GB',
        time: '6.h',
    ]
}

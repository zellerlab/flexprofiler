nextflow_pipeline {
    name "Test motus4"
    script "../main.nf"
    tag "pipeline"
    tag "test_motus4"
    profile "test_motus4"

    test("test_motus4") {
        setup {
            // test databases restricted to what the test reads hit (see assets/test-data/README.md)
            def test_data = "${baseDir}/assets/test-data/data"
            new File( "${launchDir}/database.csv" ).text = """\
                tool,db_name,db_params,db_path
                motus4,db_mOTU,,${test_data}/motus4/db_mOTU
                """.stripIndent()
        }

        when {
            params {
                outdir                = "${outputDir}"
                databases             = "${launchDir}/database.csv"
                // the human mitochondrial genome, so that host removal is fast; its bowtie2 index is built by the pipeline
                hostremoval_reference = "${baseDir}/assets/test-data/data/hostremoval/NC_012920.1.fna.gz"
            }
        }

        then {
            def stable_name       = getAllFilesFromDir( params.outdir, includeDir: true , ignore: [ 'pipeline_info/*.{html,json,txt}' ], relative: true )
            def software_versions = removeNextflowVersion( "${params.outdir}/pipeline_info/zellerlab_flexprofiler_software_mqc_versions.yml" )
            def motus4_merge      = file( "${params.outdir}/motus4/merge/motus4_db_mOTU_combined_reports.txt" )
            assertAll(
                { assert workflow.success },
                { assert snapshot ( software_versions ).match( "software_versions" ) },
                { assert snapshot ( workflow.trace.succeeded().size() ).match( "number_of_tasks" ) },
                { assert snapshot ( stable_name ).match( "filenames" ) },
                { assert snapshot (
                    getAllFilesFromDir( "${params.outdir}/motus4", include: [ '**.out' ] ).collect { file -> "${file.getName()} contains 's__Collinsella sp900768795' " + file.text.contains( "s__Collinsella sp900768795" ) },
                    getAllFilesFromDir( "${params.outdir}/motus4", include: [ '**.log' ] ).collect { file -> "${file.getName()} contains 'Finished mOTUs': " + file.text.contains( "Finished mOTUs" ) },
                    "${motus4_merge.getName()} contains 'unassigned': " + motus4_merge.text.contains( "mOTUv4.0_unassigned\td__;p___A;c__;o__;f__;g__;s__" ),
                    "${motus4_merge.getName()} contains 'Methanobrevibacter_A smithii': " + motus4_merge.text.contains( "s__Methanobrevibacter_A smithii" ),
                ).match("motus4") },
            )
        }
    }
}
